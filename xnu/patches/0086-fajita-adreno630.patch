+		.fence_pa = g_fence_pa,
+	};
+}
+
+/*
+ * The SQE firmware is copied into a fresh contiguous page below 8 GB, so
+ * CP_SQE_INSTR_BASE is inside the SMMU identity map.  As in mainline
+ * (adreno_fw_create_bo), the file's first dword is a header and is not
+ * uploaded; the version is the low 12 bits of the first uploaded dword
+ * (mainline needs >= 0x190).  Uploading the header too left the CP stuck
+ * before CP_ME_INIT on the 6T (2026-10-24, RPTR 0 WPTR 13).
+ */
+static bool
+load_sqe(void)
+{
+	uint64_t pa;
+	uint32_t len;
+	if (!blob("GPU-SQE", &pa, &len)) {
+		return false;
+	}
+	if (len < 0x100 || len > 0x40000) {
+		printf("SWEET GPU: SQE firmware size %u out of range\n", len);
+		return false;
+	}
+	len -= 4;
+	vm_size_t size = (len + PAGE_MASK) & ~PAGE_MASK;
+	vm_offset_t va;
+	uint64_t dst = gpu_alloc(&va, size);
+	if (dst == 0) {
+		return false;
+	}
+	memcpy((void *)va, (const void *)phystokv(pa + 4), len);
+	flush_dcache64((addr64_t)dst, size, TRUE);
+	g_sqe_pa = dst;
+	uint32_t ver = *(volatile uint32_t *)va & 0xfffu;
+	printf("SWEET GPU: SQE firmware %u bytes at %llx -> %llx, version %03x%s\n",
+	    len, pa, dst, ver, ver < 0x190 ? " (OLD!)" : "");
+	return true;
+}
+
+static bool
+gpu_hw_init(void)
+{
+	if (!oob_set(16, 24)) {
+		return false;
+	}
+
+	gw(R_RBBM_SECVID_TSB_CNTL, 0);
+	gw64(R_RBBM_SECVID_TSB_TRUSTED_BASE, 0);
+	gw(R_RBBM_SECVID_TSB_TRUSTED_SIZE, 0);
+	gw(R_RBBM_SECVID_TSB_ADDR_MODE_CNTL, 1);
+
+	static const uint16_t addr_mode[] = {
+		0x0842,	/* CP */
+		0x0c01,	/* VSC */
+		0x8601,	/* GRAS */
+		0x8e05,	/* RB */
+		0x9e01,	/* PC */
+		0xbe05,	/* HLSQ */
+		0xa601,	/* VFD */
+		0x9601,	/* VPC */
+		0x0e00,	/* UCHE */
+		0xae01,	/* SP */
+		0xb601,	/* TPL1 */
+	};
+	for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); i++) {
+		gw(addr_mode[i], 1);
+	}
+
+	gw(R_RBBM_VBIF_CLIENT_QOS_CNTL, 3);
+	gw(R_VBIF_GATE_OFF_WRREQ_EN, 9);
+	gw(R_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffffu);
+
+	vm_offset_t trap_va;
+	g_trap_pa = gpu_page(&trap_va);
+	if (g_trap_pa == 0) {
+		return false;
+	}
+	/*
+	 * Mainline a6xx_hw_init values: the trap/write-through page and the
+	 * write-range limit sit at the top of the GPU address space, so no
+	 * ordinary write is out of range. A real page here (g_trap_pa) is the
+	 * suspect for the CP marker the 6T never wrote (2026-10-24).
+	 */
+	gw64(R_UCHE_WRITE_RANGE_MAX, 0x0001ffffffffffc0ull);
+	gw64(R_UCHE_TRAP_BASE, 0x0001fffffffff000ull);
+	gw64(R_UCHE_WRITE_THRU_BASE, 0x0001fffffffff000ull);
+	gw64(R_UCHE_GMEM_RANGE_MIN, 0x100000);
+	gw64(R_UCHE_GMEM_RANGE_MAX, 0x1fffff);
+	gw(R_UCHE_FILTER_CNTL, 0x804);
+	gw(R_UCHE_CACHE_WAYS, 4);
+	gw(R_CP_ROQ_THRESHOLDS_2, 0x010000c0);
+	gw(R_CP_ROQ_THRESHOLDS_1, 0x8040362c);
+	gw(R_CP_MEM_POOL_SIZE, 128);
+	gw(R_PC_DBG_ECO_CNTL, 0x00180000);
+	gw(R_CP_AHB_CNTL, 1);
+	gw(R_RBBM_PERFCTR_CNTL, 1);
+	gw(R_CP_PERFCTR_CP_SEL_0, 0);		/* PERF_CP_ALWAYS_COUNT */
+	/* UBWC stays off: the client images are linear. */
+	gw(R_RB_NC_MODE_CNTL, 0);
+	gw(R_TPL1_NC_MODE_CNTL, 0);
+	gw(R_SP_NC_MODE_CNTL, 0);
+	gw(R_UCHE_MODE_CNTL, 0);
+	gw(R_RBBM_INTERFACE_HANG_INT_CNTL, (1u << 30) | 0x1fffff);
+	gw(R_UCHE_CLIENT_PF, 0x81);
+
+	gmu_wr(G_GPU_GMU_AO_GPU_CX_BUSY_MASK, 0xff000000u);
+	gmu_rmw(G_CX_GMU_POWER_COUNTER_SELECT_0, 0xffu, 1u << 5);
+	gmu_wr(G_CX_GMU_POWER_COUNTER_ENABLE, 1);
+	gw(R_RBBM_INT_0_MASK, 0x03d0e242u);
+
+	gw64(R_CP_SQE_INSTR_BASE, g_sqe_pa);
+	gw64(R_CP_RB_BASE, rb_pa);
+	gw(R_CP_RB_CNTL, 11u | (2u << 8) | (1u << 27));
+	gw(R_CP_RB_WPTR, 0);
+	gw(R_CP_SQE_CNTL, 1);
+
+	rb_n = 0;
+	emit(pkt7(CP_ME_INIT, 8));
+	emit(0x2f); emit(3); emit(0x20000000); emit(0); emit(0); emit(0); emit(0); emit(0);
+	if (!kick() || !gpu_idle()) {
+		cp_state("after CP_ME_INIT:");
+		return false;
+	}
+
+	/*
+	 * The CP starts in secure mode and cannot write non-secure memory until
+	 * the zap shader is in and CP_SET_SECURE_MODE 0 has run (mainline
+	 * a6xx_hw_init order). The marker write used to come first and never
+	 * landed on the 6T (2026-10-24: "CP marker 00000000").
+	 */
+	if (!zap_load()) {
+		printf("SWEET GPU: zap shader failed, the GPU stays secure\n");
+		return false;
+	}
+	emit(pkt7(CP_SET_SECURE_MODE, 1)); emit(0);
+	if (!kick() || !gpu_idle()) {
+		cp_state("after CP_SET_SECURE_MODE:");
+		return false;
+	}
+
+	emit(pkt7(CP_MEM_WRITE, 3));
+	emit((uint32_t)g_scratch);
+	emit((uint32_t)(g_scratch >> 32));
+	emit(0xc0ffee01u);
+	if (!kick() || !gpu_idle()) {
+		cp_state("after CP_MEM_WRITE:");
+		return false;
+	}
+	delay(1000);
+	flush_dcache64((addr64_t)g_scratch, 64, TRUE);
+	uint32_t got = *(volatile uint32_t *)g_scratch_va;
+	printf("SWEET GPU: CP marker %08x (%s)\n", got,
+	    got == 0xc0ffee01u ? "command processor works" : "NO WRITE");
+	if (got != 0xc0ffee01u) {
+		printf("SWEET GPU: marker scratch %llx trap %llx sqe %llx\n",
+		    (unsigned long long)g_scratch, (unsigned long long)g_trap_pa,
+		    (unsigned long long)g_sqe_pa);
+		cp_state("after marker:");
+		smmu_faults("after marker:");
+		return false;
+	}
+
+	oob_clear(24);			/* GMU_OOB_GPU_SET */
+	oob_clear(30);			/* GMU_OOB_BOOT_SLUMBER */
+	smmu_faults("after hw_init:");
+	printf("SWEET GPU: hw_init: RBBM_HW_VERSION %08x VBIF_VERSION %08x "
+	    "RBBM_STATUS %08x RBBM_INT %08x\n",
+	    gr(R_RBBM_HW_VERSION), gr(R_VBIF_VERSION), gr(R_RBBM_STATUS),
+	    gr(R_RBBM_INT_0_STATUS));
+	return true;
+}
+
+/* sample4 through the internal engine on two pages: exact copy, no blend. */
+static bool
+selftest_level3(void)
+{
+	vm_offset_t src_va, dst_va;
+	uint64_t src_pa = gpu_page(&src_va), dst_pa = gpu_page(&dst_va);
+	if (src_pa == 0 || dst_pa == 0) {
+		return false;
+	}
+	for (uint32_t i = 0; i < PAGE_SIZE / 4; i++) {
+		((uint32_t *)src_va)[i] = 0xff000000u | ((i * 0x9e3779b1u) & 0xffffffu);
+	}
+	bzero((void *)dst_va, PAGE_SIZE);
+	flush_dcache64((addr64_t)src_pa, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)dst_pa, PAGE_SIZE, TRUE);
+
+	uint64_t spa[1] = { src_pa }, dpa[1] = { dst_pa };
+	uint64_t sva = sweet_gpu_vm_map(spa, 1, true);
+	uint64_t dva = sweet_gpu_vm_map(dpa, 1, false);
+	if (sva == 0 || dva == 0) {
+		printf("SWEET GPU: level 3 selftest vm_map failed\n");
+		return false;
+	}
+	struct sweet_gpu_quad q;
+	memset(&q, 0, sizeof(q));
+	q.src_va = sva; q.dst_va = dva;
+	q.src_w = 64; q.src_h = 64; q.src_pitch = 256;
+	q.dst_w = 64; q.dst_h = 64; q.dst_pitch = 256;
+	q.w = 64; q.h = 64;
+	q.m[0] = 0x3f800000u; q.m[3] = 0x3f800000u;
+	q.flags = SWEET_GPU_QUAD_COPY | SWEET_GPU_QUAD_NEAREST;
+	q.color[0] = q.color[1] = q.color[2] = q.color[3] = 0x3f800000u;
+	q.src_fmt = SWEET_GPU_FMT_RGBA8;
+	q.src_swiz = SWIZ_XYZW;
+
+	int r = quad_exec(&q);
+	bool ok = r == 0;
+	uint32_t first = ~0u;
+	if (ok) {
+		uint32_t *s = (uint32_t *)src_va, *d = (uint32_t *)dst_va;
+		for (uint32_t i = 0; i < PAGE_SIZE / 4; i++) {
+			if (s[i] != d[i]) {
+				ok = false;
+				if (first == ~0u) {
+					first = i;
+				}
+			}
+		}
+	}
+	printf("SWEET GPU: level 3 sample4 selftest: quad %d, %s", r,
+	    ok ? "64x64 copy matches" : "MISMATCH");
+	if (first != ~0u) {
+		printf(" (first [%u] x %u y %u: %08x want %08x)", first, first % 64,
+		    first / 64, ((uint32_t *)dst_va)[first], ((uint32_t *)src_va)[first]);
+	}
+	printf("\n");
+	sweet_gpu_vm_unmap(sva);
+	sweet_gpu_vm_unmap(dva);
+	return ok;
+}
+
+/* Service-mode check of the public calls: quad and submit/wait. */
+static bool
+selftest_api(void)
+{
+	vm_offset_t src_va, dst_va;
+	uint64_t src_pa = gpu_page(&src_va), dst_pa = gpu_page(&dst_va);
+	if (src_pa == 0 || dst_pa == 0) {
+		return false;
+	}
+	for (uint32_t i = 0; i < PAGE_SIZE / 4; i++) {
+		((uint32_t *)src_va)[i] = 0xff000000u | ((i * 0x85ebca6bu) & 0xffffffu);
+	}
+	bzero((void *)dst_va, PAGE_SIZE);
+	flush_dcache64((addr64_t)src_pa, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)dst_pa, PAGE_SIZE, TRUE);
+	uint64_t spa[1] = { src_pa }, dpa[1] = { dst_pa };
+	uint64_t sva = sweet_gpu_vm_map(spa, 1, true);
+	uint64_t dva = sweet_gpu_vm_map(dpa, 1, false);
+	if (sva == 0 || dva == 0) {
+		return false;
+	}
+	struct sweet_gpu_quad q;
+	memset(&q, 0, sizeof(q));
+	q.src_va = sva; q.dst_va = dva;
+	q.src_w = 64; q.src_h = 64; q.src_pitch = 256;
+	q.dst_w = 64; q.dst_h = 64; q.dst_pitch = 256;
+	q.w = 64; q.h = 64;
+	q.m[0] = 0x3f800000u; q.m[3] = 0x3f800000u;
+	q.flags = SWEET_GPU_QUAD_COPY | SWEET_GPU_QUAD_NEAREST;
+	q.color[0] = q.color[1] = q.color[2] = q.color[3] = 0x3f800000u;
+	q.src_fmt = SWEET_GPU_FMT_RGBA8;
+	q.src_swiz = SWIZ_XYZW;
+
+	g_ready = true;
+	int r = sweet_gpu_quad(&q);
+	bool ok = r == 0 && memcmp((void *)src_va, (void *)dst_va, PAGE_SIZE) == 0;
+
+	/* Submit a one-packet IB through the user path and wait for the fence. */
+	uint32_t *ib = (uint32_t *)dst_va;
+	ib[0] = pkt7(CP_WAIT_FOR_IDLE, 0);
+	flush_dcache64((addr64_t)dst_pa, PAGE_SIZE, TRUE);
+	vm_offset_t fence_va;
+	uint64_t fence_pa = gpu_page(&fence_va);
+	if (fence_pa == 0) {
+		ok = false;
+	} else {
+		g_fence_va = fence_va;
+		g_fence_pa = fence_pa;
+		struct sweet_gpu_ib sib = { .iova = dva, .dwords = 1 };
+		uint32_t seq = 0;
+		int sr = sweet_gpu_submit(&sib, 1, &seq);
+		int wr = sr == 0 ? sweet_gpu_wait(seq, 1000) : sr;
+		printf("SWEET GPU: api submit -> %d, wait %d (seq %u, fence %u)\n",
+		    sr, wr, seq, fence_now());
+		ok = ok && sr == 0 && wr == 0;
+		g_fence_va = 0;
+		g_fence_pa = 0;
+	}
+	printf("SWEET GPU: api selftest: %s\n", ok ? "quad and submit work" : "FAILED");
+	g_ready = false;
+	sweet_gpu_vm_unmap(sva);
+	sweet_gpu_vm_unmap(dva);
+	return ok;
+}
+
+static void
+gpu_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	int level = (int)(uintptr_t)arg;
+	printf("SWEET GPU: Adreno 630 bring-up level %d (A630 v2, SDM845)\n", level);
+
+	if (!power_on()) {
+		printf("SWEET GPU: level 1 failed\n");
+		return;
+	}
+	if (level == 1) {
+		printf("SWEET GPU: level 1 done\n");
+		return;
+	}
+
+	g_gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	g_gmu = ml_io_map(GMU_PA, GMU_SIZE);
+	g_smmu = ml_io_map(SMMU_PA, SMMU_SIZE);
+	if (g_gpu == 0 || g_gmu == 0 || g_smmu == 0) {
+		printf("SWEET GPU: register mapping failed\n");
+		return;
+	}
+	if (!smmu_identity(g_smmu)) {
+		printf("SWEET GPU: SMMU identity map failed\n");
+		return;
+	}
+	if (!vm_init(g_smmu)) {
+		printf("SWEET GPU: GPU VA window failed\n");
+		return;
+	}
+
+	if (!gmu_boot()) {
+		printf("SWEET GPU: GMU boot failed\n");
+		return;
+	}
+	printf("SWEET GPU: GPU registers: RBBM_HW_VERSION %08x VBIF_VERSION %08x "
+	    "RBBM_STATUS %08x RBBM_INT %08x\n",
+	    gr(R_RBBM_HW_VERSION), gr(R_VBIF_VERSION), gr(R_RBBM_STATUS),
+	    gr(R_RBBM_INT_0_STATUS));
+
+	if (level < 3) {
+		printf("SWEET GPU: level 2 done (GMU up, GPU registers read)\n");
+		return;
+	}
+
+	/* Level 3 allocations: ring, CP marker scratch, IBO descriptor, SQE. */
+	vm_offset_t rb_va;
+	rb_pa = gpu_page(&rb_va);
+	if (rb_pa == 0) {
+		return;
+	}
+	rb = (uint32_t *)rb_va;
+	rb_n = 0;
+	g_scratch = gpu_page(&g_scratch_va);
+	g_ibo_pa = gpu_page(&g_ibo_va);
+	if (g_scratch == 0 || g_ibo_pa == 0) {
+		return;
+	}
+	if (!load_sqe()) {
+		return;
+	}
+	g_ksample4_pa = kernel_page(&k_sample4, &g_ksample4_va);
+	if (g_ksample4_pa == 0) {
+		printf("SWEET GPU: shader page failed\n");
+		return;
+	}
+	if (!gpu_hw_init()) {
+		printf("SWEET GPU: command processor bring-up failed\n");
+		return;
+	}
+	if (!selftest_level3()) {
+		printf("SWEET GPU: level 3 failed\n");
+		return;
+	}
+	printf("SWEET GPU: level 3 done (CP, zap, compute self-test)\n");
+	if (level < 8) {
+		return;
+	}
+	if (!selftest_api()) {
+		printf("SWEET GPU: level 8 API self-test failed\n");
+		return;
+	}
+	g_ready = true;
+	printf("SWEET GPU: service on (A630, GPU VA window 8-16 GB)\n");
+}
+
+void
+sweet_gpu_init(void)
+{
+	int on = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("sweetgpu", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(gpu_thread, (void *)(uintptr_t)on, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
