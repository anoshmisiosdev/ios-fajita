+/* SMMUv2 (arm-smmu.h). */
+#define SMMU_SCTLR		0x000u
+#define SMMU_SCR0		0x028u
+#define SMMU_SMR0		0x800u
+#define SMMU_SMR1		0x804u
+#define SMMU_S2CR0		0xc00u
+#define SMMU_S2CR1		0xc04u
+#define SMMU_TLBIALLNSNH	0x068u
+#define SMMU_STLBGSYNC		0x070u
+#define SMMU_STLBGSTATUS	0x074u
+#define SMMU_CBAR(n)		(0x1000u + (n) * 4u)
+#define SMMU_CBA2R(n)		(0x1800u + (n) * 4u)
+#define SMMU_CB(n)		(0x8000u + (n) * 0x1000u)
+#define SMMU_CB_SCTLR		0x000u
+#define SMMU_CB_TCR2		0x010u
+#define SMMU_CB_TTBR0		0x020u
+#define SMMU_CB_TCR		0x030u
+#define SMMU_CB_MAIR0		0x038u
+#define SMMU_CB_FSR		0x058u
+#define SMMU_CB_FAR		0x060u
+#define SMMU_CB_FSYNR0		0x068u
