+static uint32_t
+parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^
+	    (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static uint32_t
+pkt7(uint32_t op, uint32_t cnt)
+{
+	return (7u << 28) | cnt | (parity(cnt) << 15) | ((op & 0x7fu) << 16) | (parity(op) << 23);
+}
+
+static uint32_t
+pkt4(uint32_t reg, uint32_t cnt)
+{
+	return (4u << 28) | cnt | (parity(cnt) << 7) | ((reg & 0x3ffffu) << 8) | (parity(reg) << 27);
+}
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb sy" ::: "memory");
+	return v;
+}
+
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb sy\n\tstr %w0, [%1]\n\tdsb sy" : : "r"(v), "r"(base + off) : "memory");
+}
+
+static bool
+poll_ms(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i < ms * 10; i++) {
+		if ((rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(100);
+	}
+	return false;
+}
+
+static bool
+poll_us(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned us)
+{
+	for (unsigned i = 0; i < us; i++) {
+		if ((rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+gw(uint32_t reg, uint32_t v)
+{
+	wr(g_gpu, reg * 4, v);
+}
+
+static uint32_t
+gr(uint32_t reg)
+{
+	return rd(g_gpu, reg * 4);
+}
+
+static void
+gw64(uint32_t reg, uint64_t v)
+{
+	gw(reg, (uint32_t)v);
+	gw(reg + 1, (uint32_t)(v >> 32));
+}
+
+static uint32_t
+gmu_rd(uint32_t off)
+{
+	return rd(g_gmu, GMU_OFF(off));
+}
+
+static void
+gmu_wr(uint32_t off, uint32_t v)
+{
+	wr(g_gmu, GMU_OFF(off), v);
+}
+
+static void
+gmu_rmw(uint32_t off, uint32_t mask, uint32_t v)
+{
+	uint32_t old = gmu_rd(off);
+	gmu_wr(off, (old & ~mask) | (v & mask));
+}
+
+static uint16_t
+le16(const uint8_t *p)
+{
+	return (uint16_t)(p[0] | (p[1] << 8));
+}
+
+static uint32_t
+le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) | ((uint32_t)p[2] << 16) |
+	    ((uint32_t)p[3] << 24);
+}
+
+/* A firmware blob from the payload, as /chosen/memory-map {pa, len}. */
+static bool
+blob(const char *name, uint64_t *pa, uint32_t *len)
+{
+	DTEntry node;
+	uint64_t const *v;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+	    SecureDTGetProperty(node, name, (void const **)&v, &size) != kSuccess || size != 16) {
+		printf("SWEET GPU: no %s in /chosen/memory-map, GPU service off\n", name);
+		return false;
+	}
+	*pa = v[0];
+	*len = (uint32_t)v[1];
+	return true;
+}
+
+/* Physically contiguous, zeroed kernel memory below 8 GB; returns its PA. */
+static uint64_t
+gpu_alloc(vm_offset_t *va, vm_size_t size)
+{
+	for (int tries = 0; tries < 3; tries++) {
+		if (kmem_alloc_contig(kernel_map, va, size, PAGE_MASK,
+		    (ppnum_t)(0x200000000ull >> PAGE_SHIFT), 0,
+		    KMA_DATA | KMA_ZERO | KMA_PERMANENT,
+		    VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+			return 0;
+		}
+		uint64_t pa = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)*va));
+		if (pa >= 0x80000000ull && pa + size <= 0x200000000ull) {
+			/*
+			 * KMA_ZERO zeroed the buffer through the cached mapping:
+			 * write those lines out now. Otherwise a later clean of a
+			 * still-dirty line overwrites what the GPU wrote (the 6T's
+			 * CP marker read c0ffee01 on one boot and 0 on the next).
+			 */
+			flush_dcache64((addr64_t)pa, size, TRUE);
+			return pa;
+		}
+		printf("SWEET GPU: gpu_alloc got PA %llx outside the identity map\n", pa);
+		kmem_free(kernel_map, *va, size);
+	}
+	return 0;
+}
+
+static uint64_t
+gpu_page(vm_offset_t *va)
+{
+	return gpu_alloc(va, PAGE_SIZE);
+}
+
+/* The shader is one 16 KB page, with the binary at the start. */
+static uint64_t
+kernel_page(const struct sweet_kernel *k, vm_offset_t *va)
+{
+	uint64_t pa = gpu_page(va);
+	if (pa == 0) {
+		return 0;
+	}
+	memcpy((void *)*va, k->bin, k->size);
+	flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+	return pa;
+}
+
+static uint64_t
+usecs(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+/*
+ * Level 1: GCC branches, CX GDSC and the GMU clock.  The GX domain is left
+ * off (the GMU will own it), so no GPU register is touched here.
+ */
+static bool
+power_on(void)
+{
+	g_gcc = ml_io_map(GCC_PA, GCC_SIZE);
+	g_gpucc = ml_io_map(GPUCC_PA, GPUCC_SIZE);
+	if (g_gcc == 0 || g_gpucc == 0) {
+		return false;
+	}
+
+	/* gcc_gpu_cfg_ahb_clk first: the other GPU branches need it. */
+	wr(g_gcc, GCC_GPU_CFG_AHB, rd(g_gcc, GCC_GPU_CFG_AHB) | 1u);
+	if (!poll_ms(g_gcc, GCC_GPU_CFG_AHB, 1u << 31, 0, 10)) {
+		printf("SWEET GPU: gcc_gpu_cfg_ahb_clk did not leave halt\n");
+		return false;
+	}
+
+	/* gcc_gpu_gpll0_clk_src (bit 15) and gcc_gpu_gpll0_div_clk_src (bit 16):
+	 * no halt bit, write both enables at once. */
+	wr(g_gcc, GCC_GPU_GPLL0, rd(g_gcc, GCC_GPU_GPLL0) | (3u << 15));
+
+	/* VOTED branches: the halt bit is not a completion signal. */
+	wr(g_gcc, GCC_GPU_MEMNOC, rd(g_gcc, GCC_GPU_MEMNOC) | 1u);
+	wr(g_gcc, GCC_DDRSS_GPU_AXI, rd(g_gcc, GCC_DDRSS_GPU_AXI) | 1u);
+
+	/* CX GDSC: en_rest 2, en_few 8, clk_dis_wait 8 (gdsc.c, gpucc-sdm845.c). */
+	uint32_t gdscr = rd(g_gpucc, GPUCC_CX_GDSC);
+	gdscr = (gdscr & ~0x00fff006u) | 0x00288000u;
+	gdscr &= ~1u;
+	wr(g_gpucc, GPUCC_CX_GDSC, gdscr);
+	delay(1);
+	if (!poll_ms(g_gpucc, GPUCC_CX_GDSC_STATUS, 1u << 31, 1u << 31, 10)) {
+		printf("SWEET GPU: CX GDSC status %08x (want PWR_ON)\n",
+		    rd(g_gpucc, GPUCC_CX_GDSC_STATUS));
+		return false;
+	}
+
+	/*
+	 * The GPU SMMU's DVM clock and iref sit in the CX domain (mainline
+	 * adreno_smmu: power-domains = <&gpucc GPU_CX_GDSC>), so they only leave
+	 * halt once CX is on. Enabled before it, the DVM branch never came out
+	 * of halt on the 6T (2026-10-24, level 1).
+	 */
+	wr(g_gcc, GCC_GPU_SNOC_DVM, rd(g_gcc, GCC_GPU_SNOC_DVM) | 1u);
+	if (!poll_ms(g_gcc, GCC_GPU_SNOC_DVM, 1u << 31, 0, 10)) {
+		printf("SWEET GPU: gcc_gpu_snoc_dvm_gfx_clk did not leave halt\n");
+		return false;
+	}
+
+	wr(g_gcc, GCC_GPU_IREF, rd(g_gcc, GCC_GPU_IREF) | 1u);
+	if (!poll_ms(g_gcc, GCC_GPU_IREF, 1u << 31, 0, 10)) {
+		printf("SWEET GPU: gcc_gpu_iref_clk did not leave halt\n");
+		return false;
+	}
+
+	/*
+	 * gpu_cc_gmu_clk_src = GPLL0/2 (parent 6 in the GPUCC map) / 2:
+	 * shared RCG sequence (clk_rcg2_shared_ops): raise ROOT_EN, wait for
+	 * the status bit, write CFG, pulse UPDATE, drop ROOT_EN.
+	 */
+	wr(g_gpucc, GPUCC_GMU_RCG_CMD, rd(g_gpucc, GPUCC_GMU_RCG_CMD) | 2u);
+	if (!poll_ms(g_gpucc, GPUCC_GMU_RCG_CMD, 1u << 31, 0, 10)) {
+		printf("SWEET GPU: gmu_clk_src root enable stuck\n");
+		return false;
+	}
+	wr(g_gpucc, GPUCC_GMU_RCG_CFG, (6u << 8) | 2u);	/* parent 6, div 2: 200 MHz */
+	wr(g_gpucc, GPUCC_GMU_RCG_CMD, rd(g_gpucc, GPUCC_GMU_RCG_CMD) | 1u);
+	if (!poll_ms(g_gpucc, GPUCC_GMU_RCG_CMD, 1u << 31, 0, 10)) {
+		printf("SWEET GPU: gmu_clk_src update stuck\n");
+		return false;
+	}
+	wr(g_gpucc, GPUCC_GMU_RCG_CMD, rd(g_gpucc, GPUCC_GMU_RCG_CMD) & ~2u);
+
+	/* Recommended CX GMU branch wake/sleep settings, then enable it. */
+	uint32_t br = rd(g_gpucc, GPUCC_CX_GMU_CLK);
+	br = (br & ~0x00000ff0u) | 0x00000ff0u | 1u;
+	wr(g_gpucc, GPUCC_CX_GMU_CLK, br);
+	(void)poll_ms(g_gpucc, GPUCC_CX_GMU_CLK, 1u << 31, 0, 10);
+	wr(g_gpucc, GPUCC_CXO_CLK, rd(g_gpucc, GPUCC_CXO_CLK) | 1u);
+	(void)poll_ms(g_gpucc, GPUCC_CXO_CLK, 1u << 31, 0, 10);
+
+	printf("SWEET GPU: A630 power: chip_id %08x; GPUCC cx_gdsc %08x status %08x "
+	    "gmu_rcg %08x/%08x cx_gmu %08x cxo %08x; GCC gpll0 %08x cfg_ahb %08x "
+	    "snoc %08x iref %08x memnoc %08x ddrss %08x\n",
+	    g_chipid, rd(g_gpucc, GPUCC_CX_GDSC), rd(g_gpucc, GPUCC_CX_GDSC_STATUS),
+	    rd(g_gpucc, GPUCC_GMU_RCG_CMD), rd(g_gpucc, GPUCC_GMU_RCG_CFG),
+	    rd(g_gpucc, GPUCC_CX_GMU_CLK), rd(g_gpucc, GPUCC_CXO_CLK),
+	    rd(g_gcc, GCC_GPU_GPLL0), rd(g_gcc, GCC_GPU_CFG_AHB),
+	    rd(g_gcc, GCC_GPU_SNOC_DVM), rd(g_gcc, GCC_GPU_IREF),
+	    rd(g_gcc, GCC_GPU_MEMNOC), rd(g_gcc, GCC_DDRSS_GPU_AXI));
+	return true;
+}
+
+/*
+ * SMMU context bank 0 (GPU, stream 0): stage 1 identity map of PA 2-8 GB
+ * with 1 GB blocks.  Stream 5 (GMU) gets its own context bank 1 with a
+ * 4 KB-granule stage-1 table; gmu_smmu_init() builds it and gmu_smmu_map()
+ * fills it with the GMU debug/log/HFI buffers at IOVAs from 0x60000000.
+ * This deliberately replaces the earlier SMR[5]=BIT(31)|5<<16 idea: the
+ * stream match register number is not the SID, and a 5<<16 mask would match
+ * SID 0 too and never SID 5.
+ */
+static uint64_t *g_l1;
+static uint64_t g_l1_pa;
+static uint64_t *g_l2[8];
+static uint64_t *g_l3[GVA_CHUNKS];
+
+/* GMU (CB1) page tables: L1[1] -> one L2 -> L3 tables of the 2 MB chunks. */
+static uint64_t *g_gmu_l1, *g_gmu_l2;
+static uint64_t g_gmu_l1_pa, g_gmu_l2_pa;
+static uint64_t *g_gmu_l3[512];
+static uint64_t g_gmu_l3_pa[512];
+
+static LCK_GRP_DECLARE(sweet_gpu_grp, "sweet_gpu");
+static LCK_MTX_DECLARE(sweet_gpu_vm_lock, &sweet_gpu_grp);
+
+static void
+smmu_tlb_flush(void)
+{
+	wr(g_smmu, SMMU_TLBIALLNSNH, 0);
+	wr(g_smmu, SMMU_STLBGSYNC, 0);
+	(void)poll_ms(g_smmu, SMMU_STLBGSTATUS, 1u, 0, 10);
+}
+
+/*
+ * CB1 for the GMU: 4 KB granule, 32-bit VA (T0SZ=32 => L1 at 0x40000000-
+ * 0x7fffffff), stage 1, S2 bypass.  Only L1[1] is populated because the
+ * GMU IOVA window is 0x60000000-0x80000000.
+ */
+static bool
+gmu_smmu_init(void)
+{
+	vm_offset_t va;
+	g_gmu_l1_pa = gpu_page(&va);
+	if (g_gmu_l1_pa == 0) {
+		return false;
+	}
+	g_gmu_l1 = (uint64_t *)va;
+	bzero(g_gmu_l1, PAGE_SIZE);
+
+	g_gmu_l2_pa = gpu_page(&va);
+	if (g_gmu_l2_pa == 0) {
+		return false;
+	}
+	g_gmu_l2 = (uint64_t *)va;
+	bzero(g_gmu_l2, PAGE_SIZE);
+	g_gmu_l1[1] = g_gmu_l2_pa | 3u;		/* 1 GB table at 0x40000000 */
+	flush_dcache64((addr64_t)g_gmu_l1_pa, 4096, TRUE);
+	flush_dcache64((addr64_t)g_gmu_l2_pa, 4096, TRUE);
+
+	vm_offset_t cb = g_smmu + SMMU_CB(1);
+	wr(cb, SMMU_CB_SCTLR, 0);
+	wr(g_smmu, SMMU_CBAR(1), 1u << 16);		/* S1, S2 bypass */
+	wr(g_smmu, SMMU_CBA2R(1), 1u);			/* 64-bit TTBR0 */
+	wr(cb, SMMU_CB_TCR2, (7u << 15) | 1u);
+	wr(cb, SMMU_CB_TCR, 32u | (1u << 23));		/* 4 KB granule, 32-bit VA */
+	wr(cb, SMMU_CB_MAIR0, 0x44);
+	wr(cb, SMMU_CB_TTBR0, (uint32_t)g_gmu_l1_pa);
+	wr(cb, SMMU_CB_TTBR0 + 4, (uint32_t)(g_gmu_l1_pa >> 32));
+	wr(cb, SMMU_CB_FSR, 0xffffffffu);		/* W1C: clear stale faults */
+	wr(cb, SMMU_CB_SCTLR, 0x7);
+	return true;
+}
+
+/* Map [iova, iova+size) to PA in CB1; 4 KB pages, 4 KB-granule L3 tables. */
+static bool
+gmu_smmu_map(uint64_t iova, uint64_t pa, size_t size, bool readonly)
+{
+	if (g_gmu_l1 == NULL || (iova & 0xfffull) || (pa & 0xfffull) || size == 0 ||
+	    (size & 0xfffull) || iova < GMU_IOVA_BASE || iova + size > GMU_IOVA_END ||
+	    ((iova >> 30) & 3u) != 1u) {
+		return false;
+	}
+	uint64_t attrs = PTE_ATTRS | (readonly ? 1u << 7 : 0);
+	for (uint64_t off = 0; off < size; off += 4096) {
+		uint64_t va = iova + off;
+		uint32_t l2i = (uint32_t)((va >> 21) & 0x1ffu);
+		uint32_t l3i = (uint32_t)((va >> 12) & 0x1ffu);
+		if (g_gmu_l3[l2i] == NULL) {
+			vm_offset_t l3va;
+			uint64_t l3pa = gpu_page(&l3va);
+			if (l3pa == 0) {
+				return false;
+			}
+			g_gmu_l3[l2i] = (uint64_t *)l3va;
+			g_gmu_l3_pa[l2i] = l3pa;
+			bzero(g_gmu_l3[l2i], PAGE_SIZE);
+			flush_dcache64((addr64_t)l3va, 4096, FALSE);
+			g_gmu_l2[l2i] = l3pa | 3u;
+			flush_dcache64((addr64_t)&g_gmu_l2[l2i], 8, FALSE);
+		}
+		g_gmu_l3[l2i][l3i] = (pa + off) | 3u | attrs;
+		flush_dcache64((addr64_t)&g_gmu_l3[l2i][l3i], 8, FALSE);
+	}
+	smmu_tlb_flush();
+	return true;
+}
+
+static bool
+smmu_identity(vm_offset_t smmu)
+{
+	g_smmu = smmu;
+	vm_offset_t l1_va;
+	g_l1_pa = gpu_page(&l1_va);
+	if (g_l1_pa == 0) {
+		return false;
+	}
+	g_l1 = (uint64_t *)l1_va;
+	bzero(g_l1, PAGE_SIZE);
+	for (unsigned gb = 2; gb < 8; gb++) {
+		g_l1[gb] = ((uint64_t)gb << 30) | 1u | (1u << 6) | (2u << 8) | (1u << 10);
+	}
+	flush_dcache64((addr64_t)g_l1_pa, PAGE_SIZE, TRUE);
+
+	vm_offset_t cb = smmu + SMMU_CB(0);
+	wr(cb, SMMU_CB_SCTLR, 0);
+	wr(smmu, SMMU_CBAR(0), 1u << 16);		/* S1, S2 bypass */
+	wr(smmu, SMMU_CBA2R(0), 1u);			/* 64-bit TTBR0 */
+	wr(cb, SMMU_CB_TCR2, (7u << 15) | 1u);
+	wr(cb, SMMU_CB_TCR, 28u | (1u << 23));		/* 4 KB granule, 36-bit VA */
+	wr(cb, SMMU_CB_MAIR0, 0x44);
+	wr(cb, SMMU_CB_TTBR0, (uint32_t)g_l1_pa);
+	wr(cb, SMMU_CB_TTBR0 + 4, (uint32_t)(g_l1_pa >> 32));
+	wr(cb, SMMU_CB_FSR, 0xffffffffu);		/* W1C: clear stale faults */
+	/*
+	 * AFE|TRE|M only: no CFRE/CFIE (no SMMU IRQ handler).  The A530
+	 * driver on this same SMMU hung the GPU with CFRE set when a fetch
+	 * read past a buffer end; without it the access is terminated, the
+	 * fault is still logged in FSR/FAR and the GPU keeps running.
+	 */
+	wr(cb, SMMU_CB_SCTLR, 0x7);
+
+	if (!gmu_smmu_init()) {
+		return false;
+	}
+
+	wr(smmu, SMMU_SMR0, 1u << 31);			/* SID 0, mask 0 */
+	wr(smmu, SMMU_S2CR0, 0);			/* translate, CB0 */
+	wr(smmu, SMMU_SMR1, (1u << 31) | 5u);		/* SID 5, mask 0 */
+	wr(smmu, SMMU_S2CR1, 1);			/* translate, CB1 (GMU) */
+
+	smmu_tlb_flush();
+	vm_offset_t cb1 = smmu + SMMU_CB(1);
+	printf("SWEET GPU: SMMU cb0ttbr %llx cb1ttbr %llx sctlr %08x/%08x tcr %08x/%08x "
+	    "smr %08x/%08x s2cr %08x/%08x fsr %08x/%08x\n",
+	    g_l1_pa, g_gmu_l1_pa, rd(cb, SMMU_CB_SCTLR), rd(cb1, SMMU_CB_SCTLR),
+	    rd(cb, SMMU_CB_TCR), rd(cb1, SMMU_CB_TCR),
+	    rd(smmu, SMMU_SMR0), rd(smmu, SMMU_SMR1),
+	    rd(smmu, SMMU_S2CR0), rd(smmu, SMMU_S2CR1),
+	    rd(cb, SMMU_CB_FSR), rd(cb1, SMMU_CB_FSR));
+	return (rd(cb, SMMU_CB_SCTLR) & 7u) == 7u &&
+	    (rd(cb1, SMMU_CB_SCTLR) & 7u) == 7u &&
+	    (rd(smmu, SMMU_CBAR(0)) & (3u << 16)) == (1u << 16) &&
+	    (rd(smmu, SMMU_CBAR(1)) & (3u << 16)) == (1u << 16) &&
+	    rd(smmu, SMMU_SMR0) == (1u << 31) &&
+	    rd(smmu, SMMU_SMR1) == ((1u << 31) | 5u) &&
+	    rd(smmu, SMMU_S2CR0) == 0 &&
+	    rd(smmu, SMMU_S2CR1) == 1u;
+}
+
+/*
+ * GPU VA window 8-16 GB: L1[8..15] -> L2 (512 x 2 MB) -> L3 (512 x 4 KB).
+ * Same allocator as the A530 driver: page-granular first fit from a rover,
+ * VM_PAD scratch pages after each mapping, 4 KB tables carved from 16 KB
+ * pages.  g_owner[page] is the mapping index (0 free, VM_GUARD padding).
+ */
+struct vm_mapping {
+	uint64_t va;            /* 0: free slot */
+	uint64_t *pa;           /* npages physical page addresses */
+	uint32_t npages;
+	bool ro;
+};
+static struct vm_mapping *g_maps;
+static uint16_t *g_owner;
+static uint32_t g_rover, g_map_rover = 1;
+static uint64_t g_pad_pa[VM_PAD];
+
+static uint64_t *
+pt4k(uint64_t *pa)
+{
+	static vm_offset_t pool_va;
+	static uint64_t pool_pa;
+	static unsigned pool_left;
+	if (pool_left == 0) {
+		pool_pa = gpu_page(&pool_va);
+		if (pool_pa == 0) {
+			return NULL;
+		}
+		pool_left = PAGE_SIZE / 4096;
+	}
+	unsigned i = PAGE_SIZE / 4096 - pool_left--;
+	*pa = pool_pa + i * 4096;
+	return (uint64_t *)(pool_va + i * 4096);
+}
+
+static bool
+vm_init(vm_offset_t smmu)
+{
+	g_smmu = smmu;
+	g_maps = kalloc_data(VM_MAPS * sizeof(g_maps[0]), Z_WAITOK | Z_ZERO);
+	g_owner = kalloc_data(GVA_PAGES * sizeof(g_owner[0]), Z_WAITOK | Z_ZERO);
+	vm_offset_t pad_va;
+	uint64_t pad = gpu_page(&pad_va);
+	if (g_maps == NULL || g_owner == NULL || pad == 0) {
+		return false;
+	}
+	for (unsigned i = 0; i < VM_PAD; i++) {
+		g_pad_pa[i] = pad;
+	}
+	for (unsigned gb = 0; gb < 8; gb++) {
+		uint64_t pa;
+		g_l2[gb] = pt4k(&pa);
+		if (g_l2[gb] == NULL) {
+			return false;
+		}
+		g_l1[8 + gb] = pa | 3u;
+	}
+	flush_dcache64((addr64_t)g_l1_pa, 4096, TRUE);
+	smmu_tlb_flush();
+	return true;
+}
+
+static int64_t
+vm_find(uint32_t n)
+{
+	for (int pass = 0; pass < 2; pass++) {
+		uint32_t start = pass ? 0 : g_rover, end = pass ? g_rover : GVA_PAGES;
+		uint32_t run = 0;
+		for (uint32_t p = start; p < end; p++) {
+			run = g_owner[p] ? 0 : run + 1;
+			if (run == n) {
+				return p + 1 - n;
+			}
+		}
+	}
+	return -1;
+}
+
+static bool
+vm_tables(uint32_t first, uint32_t n)
+{
+	uint32_t per = (2u << 20) / PAGE_SIZE;
+	for (uint32_t c = first / per; c <= (first + n - 1) / per; c++) {
+		if (g_l3[c] != NULL) {
+			continue;
+		}
+		uint64_t l3pa;
+		g_l3[c] = pt4k(&l3pa);
+		if (g_l3[c] == NULL) {
+			return false;
+		}
+		bzero(g_l3[c], 4096);
+		flush_dcache64((addr64_t)g_l3[c], 4096, FALSE);
+		uint64_t *l2 = g_l2[c / 512];
+		l2[c % 512] = l3pa | 3u;
+		flush_dcache64((addr64_t)&l2[c % 512], 8, FALSE);
+	}
+	return true;
+}
+
+static void
+vm_ptes(uint32_t first, uint32_t n, const uint64_t *pa, bool readonly)
+{
+	uint32_t sub = PAGE_SIZE / 4096;
+	uint64_t attrs = PTE_ATTRS | (readonly ? 1u << 7 : 0);
+	uint64_t i0 = (uint64_t)first * sub, i1 = (uint64_t)(first + n) * sub;
+	for (uint64_t i = i0; i < i1; i++) {
+		g_l3[i / 512][i % 512] = pa ? (pa[i / sub - first] + (i % sub) * 4096) | 3u | attrs : 0;
+	}
+	for (uint64_t t = i0 / 512; t <= (i1 - 1) / 512; t++) {
+		flush_dcache64((addr64_t)g_l3[t], 4096, FALSE);
+	}
+}
+
+uint64_t
+sweet_gpu_vm_map(const uint64_t *pa, uint32_t npages, bool readonly)
+{
+	if (g_maps == NULL || npages == 0 || npages >= GVA_PAGES) {
+		return 0;
+	}
+	uint64_t *pages = kalloc_data(npages * sizeof(uint64_t), Z_WAITOK);
+	if (pages == NULL) {
+		return 0;
+	}
+	memcpy(pages, pa, npages * sizeof(uint64_t));
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	uint32_t m = 0;
+	for (uint32_t k = 0; k < VM_MAPS - 1 && m == 0; k++) {
+		uint32_t i = 1 + (g_map_rover - 1 + k) % (VM_MAPS - 1);
+		m = g_maps[i].va == 0 ? i : 0;
+	}
+	int64_t first = m ? vm_find(npages + VM_PAD) : -1;
+	if (first < 0 || !vm_tables((uint32_t)first, npages + VM_PAD)) {
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		kfree_data(pages, npages * sizeof(uint64_t));
+		return 0;
+	}
+	for (uint32_t p = 0; p < npages; p++) {
+		g_owner[first + p] = (uint16_t)m;
+	}
+	for (uint32_t p = 0; p < VM_PAD; p++) {
+		g_owner[first + npages + p] = VM_GUARD;
+	}
+	g_rover = (uint32_t)first + npages + VM_PAD;
+	g_map_rover = m + 1;
+	uint64_t va = GVA_BASE + (uint64_t)first * PAGE_SIZE;
+	g_maps[m] = (struct vm_mapping){ .va = va, .pa = pages, .npages = npages, .ro = readonly };
+	vm_ptes((uint32_t)first, npages, pages, readonly);
+	vm_ptes((uint32_t)first + npages, VM_PAD, g_pad_pa, false);
+	smmu_tlb_flush();
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	return va;
+}
+
+void
+sweet_gpu_vm_unmap(uint64_t va)
+{
+	if (g_maps == NULL || va < GVA_BASE || va - GVA_BASE >= (uint64_t)GVA_PAGES * PAGE_SIZE || (va & PAGE_MASK)) {
+		return;
+	}
+	uint32_t first = (uint32_t)((va - GVA_BASE) / PAGE_SIZE);
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	uint32_t m = g_owner[first];
+	if (m == 0 || m == VM_GUARD || g_maps[m].va != va) {
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		return;
+	}
+	uint32_t n = g_maps[m].npages;
+	uint64_t *pages = g_maps[m].pa;
+	vm_ptes(first, n + VM_PAD, NULL, false);
+	smmu_tlb_flush();
+	for (uint32_t p = 0; p < n + VM_PAD; p++) {
+		g_owner[first + p] = 0;
+	}
+	g_maps[m] = (struct vm_mapping){ 0 };
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	kfree_data(pages, n * sizeof(uint64_t));
+}
+
+static int
+vm_range(uint64_t va, uint64_t len)
+{
+	if (g_maps == NULL || len == 0 || va < GVA_BASE || va - GVA_BASE >= (uint64_t)GVA_PAGES * PAGE_SIZE) {
+		return -1;
+	}
+	uint32_t m = g_owner[(va - GVA_BASE) / PAGE_SIZE];
+	if (m == 0 || m == VM_GUARD) {
+		return -1;
+	}
+	uint64_t end = g_maps[m].va + (uint64_t)g_maps[m].npages * PAGE_SIZE;
+	return len <= end - va ? (int)m : -1;
+}
+
+static void
+vm_cache(uint32_t m, uint64_t va, uint64_t len)
+{
+	uint64_t off = va - g_maps[m].va;
+	for (uint64_t p = off / PAGE_SIZE; p <= (off + len - 1) / PAGE_SIZE; p++) {
+		if (pmap_valid_page((ppnum_t)atop(g_maps[m].pa[p]))) {
+			flush_dcache64((addr64_t)g_maps[m].pa[p], PAGE_SIZE, TRUE);
+		}
+	}
+}
+
+/*
+ * RPMh arc votes.  a6xx_gmu_rpmh_init() in mainline runs the same algorithm
+ * from the cmd-db: for each OPP level find the first primary arc level >=
+ * it and the first secondary arc level >= it (or the last non-zero
+ * secondary), and pack (primary_level << 16) | (secondary_index << 8) |
+ * primary_index.  The GMU sends these to RPMh itself; without them no
+ * gfx/mx/cx vote reaches the AOP and the GX rail never comes up.
+ */
+#define ARC_MAX 16
+static uint16_t g_gfx_lvl[ARC_MAX], g_mx_lvl[ARC_MAX], g_cx_lvl[ARC_MAX];
+static uint32_t g_gfx_n, g_mx_n, g_cx_n;
+
+static uint32_t
+arc_read(const char *name, uint16_t *out)
+{
+	uint8_t buf[ARC_MAX * 2];
+	uint32_t len = 0;
+	if (sweet_rpmh_cmd_db_aux(name, buf, sizeof(buf), &len) != 0 || len < 2) {
+		printf("SWEET GPU: cmd-db %s read failed\n", name);
+		return 0;
+	}
+	uint32_t n = len / 2;
+	if (n > ARC_MAX) {
+		n = ARC_MAX;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		out[i] = (uint16_t)(buf[2 * i] | (buf[2 * i + 1] << 8));
+	}
+	printf("SWEET GPU: cmd-db %s (%u):", name, n);
+	for (uint32_t i = 0; i < n; i++) {
+		printf(" %u", out[i]);
+	}
+	printf("\n");
+	return n;
+}
+
+static bool
+arc_vote(const uint16_t *pri, uint32_t pn, const uint16_t *sec, uint32_t sn,
+    uint32_t level, uint32_t *vote)
+{
+	uint32_t p = 0, s = 0;
+	while (p < pn && pri[p] < level) {
+		p++;
+	}
+	if (p == pn) {
+		return false;
+	}
+	while (s < sn && sec[s] < level) {
+		s++;
+	}
+	if (s == sn) {
+		s = sn - 1;
+		while (s > 0 && sec[s] == 0) {
+			s--;
+		}
+	}
+	*vote = ((uint32_t)pri[p] << 16) | (s << 8) | p;
+	return true;
+}
+
+static bool
+arc_votes(void)
+{
+	g_gfx_n = arc_read("gfx.lvl", g_gfx_lvl);
+	g_mx_n = arc_read("mx.lvl", g_mx_lvl);
+	g_cx_n = arc_read("cx.lvl", g_cx_lvl);
+	if (g_gfx_n == 0 || g_mx_n == 0 || g_cx_n == 0) {
+		printf("SWEET GPU: cmd-db arc levels missing; cannot boot the GMU\n");
+		return false;
+	}
+	for (unsigned i = 0; i < 8; i++) {
+		if (!arc_vote(g_gfx_lvl, g_gfx_n, g_mx_lvl, g_mx_n, g_gpu_levels[i], &g_gx_votes[i])) {
+			printf("SWEET GPU: gfx level %u has no arc vote\n", g_gpu_levels[i]);
+			return false;
+		}
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		if (!arc_vote(g_cx_lvl, g_cx_n, g_mx_lvl, g_mx_n, g_gmu_levels[i], &g_cx_votes[i])) {
+			printf("SWEET GPU: cx level %u has no arc vote\n", g_gmu_levels[i]);
+			return false;
+		}
+	}
+	printf("SWEET GPU: gx votes:");
+	for (unsigned i = 0; i < 8; i++) {
+		printf(" %08x", g_gx_votes[i]);
+	}
+	printf("; cx votes:");
+	for (unsigned i = 0; i < 3; i++) {
+		printf(" %08x", g_cx_votes[i]);
+	}
+	printf("\n");
+	return true;
+}
+/* HFI shared memory: one 16 KB page: table+headers, then 4 KB per queue. */
+static vm_offset_t g_dbg_va, g_log_va;
+static uint64_t g_dbg_pa, g_log_pa;
+static volatile struct hfi_table *g_hfi;
+static volatile uint32_t *g_hfi_data[3];
+static uint64_t g_hfi_data_pa[3];
+
+static void
+hfi_init(void)
+{
+	g_hfi = (volatile struct hfi_table *)g_hfi_va;
+	bzero((void *)g_hfi, PAGE_SIZE);
+	g_hfi->version = 0;
+	g_hfi->size = sizeof(struct hfi_table);
+	g_hfi->qhdr0_offset = 6;			/* table header is 6 dwords */
+	g_hfi->qhdr_size = sizeof(struct hfi_qhdr) >> 2;
+	g_hfi->num_queues = HFI_NUM_QUEUES;
+	g_hfi->active_queues = HFI_NUM_QUEUES;
+	static const uint32_t ids[HFI_NUM_QUEUES] = { HFI_CMD_ID, HFI_RESP_ID, HFI_DEBUG_ID };
+	for (unsigned i = 0; i < HFI_NUM_QUEUES; i++) {
+		uint32_t off = (i + 1) * 0x1000;
+		g_hfi_data[i] = (volatile uint32_t *)(g_hfi_va + off);
+		g_hfi_data_pa[i] = g_hfi_pa + off;
+		volatile struct hfi_qhdr *q = &g_hfi->qhdr[i];
+		q->status = 1;
+		q->iova = (uint32_t)(g_hfi_iova + off);
+		q->type = (10u << 8) | ids[i];
+		q->size = HFI_QUEUE_DWORDS;
+		q->msg_size = 0;
+		q->dropped = 0;
+		q->rx_watermark = 1;
+		q->tx_watermark = 1;
+		q->rx_request = 1;
+		q->tx_request = 0;
+		q->read_index = 0;
+		q->write_index = 0;
+	}
+	flush_dcache64((addr64_t)g_hfi_pa, PAGE_SIZE, TRUE);
+}
+
+static int
+hfi_send(uint32_t id, uint32_t *msg, uint32_t dwords)
+{
+	volatile struct hfi_qhdr *q = &g_hfi->qhdr[0];
+	uint32_t seq = ++g_hfi_seq % 0xfff;
+	g_hfi_last_seq = seq;
+	msg[0] = (seq << 20) | (0u << 16) | (dwords << 8) | id;
+	/* The GMU updates read_index in DRAM: invalidate before reading it. */
+	flush_dcache64((addr64_t)g_hfi_pa, PAGE_SIZE, TRUE);
+	uint32_t space = (q->read_index - q->write_index - 1) & (HFI_QUEUE_DWORDS - 1);
+	if (dwords > space) {
+		printf("SWEET GPU: HFI queue full (%u > %u)\n", dwords, space);
+		return ENOSPC;
+	}
+	uint32_t w = q->write_index;
+	for (uint32_t i = 0; i < dwords; i++) {
+		g_hfi_data[0][w] = msg[i];
+		w = (w + 1) & (HFI_QUEUE_DWORDS - 1);
+	}
+	q->write_index = w;
+	/* Data before the index that publishes it. */
+	flush_dcache64((addr64_t)g_hfi_data_pa[0], PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)g_hfi_pa, PAGE_SIZE, TRUE);
+	gmu_wr(G_HOST2GMU_INTR_SET, 1);
+	return 0;
+}
+
+/*
+ * The response is a6xx_hfi_msg_response: header (id 126), ret_header (the
+ * request header, with its seq), error, payload[16].  Read all 19 dwords,
+ * like a6xx_hfi_queue_read() in mainline.
+ */
+static int
+hfi_recv(uint32_t *resp)
+{
+	volatile struct hfi_qhdr *q = &g_hfi->qhdr[1];
+
+	for (int tries = 0; tries < 4; tries++) {
+		flush_dcache64((addr64_t)g_hfi_pa, PAGE_SIZE, TRUE);
+		uint32_t r = q->read_index;
+		if (r == q->write_index) {
+			/* Ask the GMU for a response interrupt, then wait. */
+			q->rx_request = 1;
+			flush_dcache64((addr64_t)g_hfi_pa, PAGE_SIZE, TRUE);
+			if (!poll_ms(g_gmu, GMU_OFF(G_GMU2HOST_INTR_INFO), 1u, 1u, 1000)) {
+				printf("SWEET GPU: HFI ack timeout, intr %08x\n",
+				    gmu_rd(G_GMU2HOST_INTR_INFO));
+				return ETIMEDOUT;
+			}
+			gmu_wr(G_GMU2HOST_INTR_CLR, 1u);
+			continue;
+		}
+		uint32_t hdr;
+		flush_dcache64((addr64_t)g_hfi_data_pa[1], PAGE_SIZE, TRUE);
+		hdr = g_hfi_data[1][r];
+		uint32_t n = (hdr >> 8) & 0xff;		/* message size in dwords */
+		if (n < 3 || n > 19) {
+			printf("SWEET GPU: HFI bad response header %08x\n", hdr);
+			return EIO;
+		}
+		memset(resp, 0, 19 * sizeof(uint32_t));
+		for (uint32_t i = 0; i < n; i++) {
+			resp[i] = g_hfi_data[1][r];
+			r = (r + 1) & (HFI_QUEUE_DWORDS - 1);
+		}
+		q->read_index = r;
+		flush_dcache64((addr64_t)g_hfi_pa, PAGE_SIZE, TRUE);
+		return 0;
+	}
+	return EAGAIN;
+}
+
+static int
+hfi_request(uint32_t id, uint32_t *msg, uint32_t dwords, uint32_t *payload)
+{
+	int err = hfi_send(id, msg, dwords);
+	if (err) {
+		return err;
+	}
+	for (int tries = 0; tries < 8; tries++) {
+		uint32_t resp[19];
+		err = hfi_recv(resp);
+		if (err) {
+			return err;
+		}
+		if ((resp[0] & 0xff) == 100) {		/* HFI_F2H_MSG_ERROR */
+			printf("SWEET GPU: GMU firmware error %u (msg %u)\n", resp[1], id);
+			continue;
+		}
+		if (((resp[1] >> 20) & 0xfff) != g_hfi_last_seq) {
+			printf("SWEET GPU: HFI id %u stale response seq %u (want %u)\n", id,
+			    (resp[1] >> 20) & 0xfff, g_hfi_last_seq);
+			continue;
+		}
+		if (resp[2] != 0) {
+			printf("SWEET GPU: HFI id %u error %u\n", id, resp[2]);
+			return EIO;
+		}
+		if (payload) {
+			for (unsigned i = 0; i < 16; i++) {
+				payload[i] = resp[3 + i];
+			}
+		}
+		return 0;
+	}
+	return EIO;
+}
+
+static bool
+gmu_load_fw(void)
+{
+	uint64_t pa;
+	uint32_t len;
+	if (!blob("GPU-GMU", &pa, &len)) {
+		return false;
+	}
+	if (len == 0 || len > 0x8000) {
+		printf("SWEET GPU: GMU firmware size %u (legacy limit 32768)\n", len);
+		return false;
+	}
+	const uint8_t *fw = (const uint8_t *)phystokv(pa);
+	for (uint32_t off = 0; off < len; off += 4) {
+		uint32_t v = 0;
+		for (unsigned b = 0; b < 4 && off + b < len; b++) {
+			v |= (uint32_t)fw[off + b] << (8 * b);
+		}
+		gmu_wr(G_CM3_ITCM_START + off / 4, v);
+	}
+	printf("SWEET GPU: GMU firmware %u bytes at %llx\n", len, pa);
+	return true;
+}
+
+static bool
+oob_set(uint32_t set, uint32_t ack)
+{
+	gmu_wr(G_HOST2GMU_INTR_SET, 1u << set);
+	if (!poll_ms(g_gmu, GMU_OFF(G_GMU2HOST_INTR_INFO), 1u << ack, 1u << ack, 1000)) {
+		printf("SWEET GPU: OOB %u not acked (intr %08x)\n", set, gmu_rd(G_GMU2HOST_INTR_INFO));
+		return false;
+	}
+	gmu_wr(G_GMU2HOST_INTR_CLR, 1u << ack);
+	return true;
+}
+
+static void
+oob_clear(uint32_t clear)
+{
+	gmu_wr(G_HOST2GMU_INTR_SET, 1u << clear);
+}
+
+static bool
+gmu_start(void)
+{
+	uint32_t val = gmu_rd(G_CM3_DTCM_START + 0xff8);
+	uint32_t mask, reset;
+	if (val <= 0x20010004u) {
+		mask = 0xffffffffu;
+		reset = 0xbabefaceu;
+	} else {
+		mask = 0x1ffu;
+		reset = 0x100u;
+	}
+	printf("SWEET GPU: GMU start dtcm %08x, mask %08x want %08x\n", val, mask, reset);
+	gmu_wr(G_CM3_SYSRESET, 1);
+	gmu_wr(G_PWR_COL_CP_RESP, 0);
+	gmu_wr(G_CM3_SYSRESET, 0);
+	if (!poll_ms(g_gmu, GMU_OFF(G_CM3_FW_INIT_RESULT), mask, reset, 5000)) {
+		printf("SWEET GPU: GMU firmware init timeout, result %08x\n", gmu_rd(G_CM3_FW_INIT_RESULT));
+		return false;
+	}
+	printf("SWEET GPU: GMU firmware init result %08x\n", gmu_rd(G_CM3_FW_INIT_RESULT));
+	return true;
+}
+
+static bool
+gmu_gfx_rail_on(void)
+{
+	uint32_t vote = g_gx_votes[7];
+	gmu_wr(G_BOOT_SLUMBER_OPTION, 0);
+	gmu_wr(G_GX_VOTE_IDX, vote & 0xff);
+	gmu_wr(G_MX_VOTE_IDX, (vote >> 8) & 0xff);
+	printf("SWEET GPU: gfx rail on, vote %08x\n", vote);
+	return oob_set(22, 30);
+}
+
+static bool
+gmu_sptprac_enable(void)
+{
+	gmu_wr(G_GX_SPTPRAC_POWER_CONTROL, 0x778000u);
+	bool ok = poll_us(g_gmu, GMU_OFF(G_SPTPRAC_PWR_CLK_STATUS), 0x38u, 0x28u, 100);
+	printf("SWEET GPU: sptprac %s, status %08x\n", ok ? "on" : "TIMEOUT",
+	    gmu_rd(G_SPTPRAC_PWR_CLK_STATUS));
+	return ok;
+}
+
+static bool
+gmu_hfi_start(void)
+{
+	gmu_wr(G_HFI_CTRL_INIT, 1);
+	if (!poll_ms(g_gmu, GMU_OFF(G_HFI_CTRL_STATUS), 1u, 1u, 1000)) {
+		printf("SWEET GPU: HFI ctrl init timeout, status %08x\n", gmu_rd(G_HFI_CTRL_STATUS));
+		return false;
+	}
+
+	uint32_t msg[160], payload[16];
+	int err;
+
+	payload[0] = 0;
+	memset(msg, 0, sizeof(msg));
+	msg[1] = 0;
+	msg[2] = (uint32_t)g_dbg_iova;
+	msg[3] = 0x4000;
+	msg[4] = 1;
+	err = hfi_request(0, msg, 5, payload);		/* HFI_H2F_MSG_INIT */
+	printf("SWEET GPU: HFI init -> %d, boot_state %u\n", err, payload[0]);
+	if (err) {
+		return false;
+	}
+
+	memset(msg, 0, sizeof(msg));
+	msg[1] = (1u << 28) | (1u << 19) | (1u << 17);
+	err = hfi_request(1, msg, 2, payload);		/* HFI_H2F_MSG_FW_VERSION */
+	printf("SWEET GPU: HFI fw version -> %d, gmu %08x\n", err, payload[0]);
+	if (err) {
+		return false;
+	}
+
+	/* PERF_TABLE v1: 43 dwords, gx pairs at 3, cx pairs at 35. */
+	memset(msg, 0, sizeof(msg));
+	msg[1] = 8;
+	msg[2] = 3;
+	for (unsigned i = 0; i < 8; i++) {
+		msg[3 + 2 * i] = g_gx_votes[i];
+		msg[4 + 2 * i] = g_gpu_freqs[i] / 1000;
+	}
+	for (unsigned i = 0; i < 3; i++) {
+		msg[35 + 2 * i] = g_cx_votes[i];
+		msg[36 + 2 * i] = g_gmu_freqs[i] / 1000;
+	}
+	err = hfi_request(4, msg, 43, payload);		/* HFI_H2F_MSG_PERF_TABLE */
+	printf("SWEET GPU: HFI perf table -> %d\n", err);
+	if (err) {
+		return false;
+	}
+
+	/* BW_TABLE: single off entry, A630's fixed DDR/CNOC votes. */
+	memset(msg, 0, sizeof(msg));
+	msg[1] = 1;
+	msg[2] = 3;
+	msg[3] = 3;
+	msg[4] = 0x05;
+	msg[5] = 0x07;
+	msg[6] = 0x50034; msg[7] = 0x5007c; msg[8] = 0x5004c;
+	msg[12] = 0x40000000; msg[13] = 0; msg[14] = 0x40000000;
+	msg[18] = 0x60000001; msg[19] = 0x20000001; msg[20] = 0x60000001;
+	msg[24] = 0x50000; msg[25] = 0x5005c; msg[26] = 0x5000c;
+	msg[32] = 0x40000000; msg[33] = 0x40000000; msg[34] = 0x40000000;
+	err = hfi_request(3, msg, 160, payload);	/* HFI_H2F_MSG_BW_TABLE */
+	printf("SWEET GPU: HFI bw table -> %d\n", err);
+	if (err) {
+		return false;
+	}
+
+	memset(msg, 0, sizeof(msg));
+	err = hfi_request(5, msg, 1, payload);		/* HFI_H2F_MSG_TEST */
+	/* mainline does not wait for (or check) a TEST ack on legacy GMUs */
+	printf("SWEET GPU: HFI test -> %d\n", err);
+	return true;
+}
+
+/*
+ * RPMh/PDC cold-boot setup, ported from mainline a6xx_gmu_rpmh_init() for
+ * the A630 (non-a650 sequencer values, default pdc_address_offset).  RSCC
+ * is at GMU base + 0x23000; the GPU PDC and its sequencer RAM are separate
+ * mappings at 0xb280000 and 0xb480000.  Register offsets are dwords.
+ * Called once, before the first GMU start.
+ */
+static bool
+gmu_rpmh_init(void)
+{
+	g_pdc = ml_io_map(GMU_PDC_PA, GMU_PDC_SIZE);
+	g_pdc_seq = ml_io_map(GMU_PDC_SEQ_PA, GMU_PDC_SIZE);
+	if (g_pdc == 0 || g_pdc_seq == 0) {
+		printf("SWEET GPU: GMU PDC mapping failed\n");
+		return false;
+	}
+
+	/* Disable SDE clock gating. */
+	wr(g_gmu, GMU_RSCC_OFF + RSCC_RSC_STATUS0_DRV0 * 4u, 1u << 24);
+
+	/* Setup RSC PDC handshake for sleep and wakeup. */
+	wr(g_gmu, GMU_RSCC_OFF + RSCC_PDC_SLAVE_ID_DRV0 * 4u, 1);
+	wr(g_gmu, GMU_RSCC_OFF + RSCC_HIDDEN_TCS_CMD0_DATA * 4u, 0);
+	wr(g_gmu, GMU_RSCC_OFF + RSCC_HIDDEN_TCS_CMD0_ADDR * 4u, 0);
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_HIDDEN_TCS_CMD0_DATA + 2) * 4u, 0);
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_HIDDEN_TCS_CMD0_ADDR + 2) * 4u, 0);
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_HIDDEN_TCS_CMD0_DATA + 4) * 4u, 0x80000000u);
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_HIDDEN_TCS_CMD0_ADDR + 4) * 4u, 0);
+	wr(g_gmu, GMU_RSCC_OFF + RSCC_OVERRIDE_START_ADDR * 4u, 0);
+	wr(g_gmu, GMU_RSCC_OFF + RSCC_PDC_SEQ_START_ADDR * 4u, 0x4520);
+	wr(g_gmu, GMU_RSCC_OFF + RSCC_PDC_MATCH_VALUE_LO * 4u, 0x4510);
+	wr(g_gmu, GMU_RSCC_OFF + RSCC_PDC_MATCH_VALUE_HI * 4u, 0x4514);
+
+	/* Load the non-a650 RSC sequencer microcode (sleep and wakeup). */
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_SEQ_MEM_0_DRV0 + 0) * 4u, 0xa7a506a0);
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_SEQ_MEM_0_DRV0 + 1) * 4u, 0xa1e6a6e7);
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_SEQ_MEM_0_DRV0 + 2) * 4u, 0xa2e081e1);
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_SEQ_MEM_0_DRV0 + 3) * 4u, 0xe9a982e2);
+	wr(g_gmu, GMU_RSCC_OFF + (RSCC_SEQ_MEM_0_DRV0 + 4) * 4u, 0x0020e8a8);
+
+	/* Load the PDC sequencer microcode for power up and power down. */
+	wr(g_pdc_seq, (PDC_GPU_SEQ_MEM_0 + 0) * 4u, 0xfebea1e1);
+	wr(g_pdc_seq, (PDC_GPU_SEQ_MEM_0 + 1) * 4u, 0xa5a4a3a2);
+	wr(g_pdc_seq, (PDC_GPU_SEQ_MEM_0 + 2) * 4u, 0x8382a6e0);
+	wr(g_pdc_seq, (PDC_GPU_SEQ_MEM_0 + 3) * 4u, 0xbce3e284);
+	wr(g_pdc_seq, (PDC_GPU_SEQ_MEM_0 + 4) * 4u, 0x002081fc);
+
+	/* TCS1 commands: power up sequence. */
+	wr(g_pdc, PDC_GPU_TCS1_CMD_ENABLE_BANK * 4u, 7);
+	wr(g_pdc, PDC_GPU_TCS1_CMD_WAIT_FOR_CMPL_BANK * 4u, 0);
+	wr(g_pdc, PDC_GPU_TCS1_CONTROL * 4u, 0);
+	wr(g_pdc, PDC_GPU_TCS1_CMD0_MSGID * 4u, 0x10108);
+	wr(g_pdc, PDC_GPU_TCS1_CMD0_ADDR * 4u, 0x30010);
+	wr(g_pdc, PDC_GPU_TCS1_CMD0_DATA * 4u, 1);
+	wr(g_pdc, (PDC_GPU_TCS1_CMD0_MSGID + 4) * 4u, 0x10108);
+	wr(g_pdc, (PDC_GPU_TCS1_CMD0_ADDR + 4) * 4u, 0x30000);
+	wr(g_pdc, (PDC_GPU_TCS1_CMD0_DATA + 4) * 4u, 0);
+	wr(g_pdc, (PDC_GPU_TCS1_CMD0_MSGID + 8) * 4u, 0x10108);
+	wr(g_pdc, (PDC_GPU_TCS1_CMD0_ADDR + 8) * 4u, GMU_PDC_ADDRESS_OFFSET);
+	wr(g_pdc, (PDC_GPU_TCS1_CMD0_DATA + 8) * 4u, 0);
+
+	/* TCS3 commands: power down sequence. */
+	wr(g_pdc, PDC_GPU_TCS3_CMD_ENABLE_BANK * 4u, 7);
+	wr(g_pdc, PDC_GPU_TCS3_CMD_WAIT_FOR_CMPL_BANK * 4u, 0);
+	wr(g_pdc, PDC_GPU_TCS3_CONTROL * 4u, 0);
+	wr(g_pdc, PDC_GPU_TCS3_CMD0_MSGID * 4u, 0x10108);
+	wr(g_pdc, PDC_GPU_TCS3_CMD0_ADDR * 4u, 0x30010);
+	wr(g_pdc, PDC_GPU_TCS3_CMD0_DATA * 4u, 2);
+	wr(g_pdc, (PDC_GPU_TCS3_CMD0_MSGID + 4) * 4u, 0x10108);
+	wr(g_pdc, (PDC_GPU_TCS3_CMD0_ADDR + 4) * 4u, 0x30000);
+	wr(g_pdc, (PDC_GPU_TCS3_CMD0_DATA + 4) * 4u, 0x3);	/* not a618/a619/a650 */
+	wr(g_pdc, (PDC_GPU_TCS3_CMD0_MSGID + 8) * 4u, 0x10108);
+	wr(g_pdc, (PDC_GPU_TCS3_CMD0_ADDR + 8) * 4u, GMU_PDC_ADDRESS_OFFSET);
+	wr(g_pdc, (PDC_GPU_TCS3_CMD0_DATA + 8) * 4u, 0x3);
+
+	/* Setup GPU PDC, then make sure the uCode is fully written. */
+	wr(g_pdc, PDC_GPU_SEQ_START_ADDR * 4u, 0);
+	wr(g_pdc, PDC_GPU_ENABLE_PDC * 4u, 0x80000001u);
+	__asm__ volatile("dmb sy" ::: "memory");
+
+	printf("SWEET GPU: GMU RPMh/PDC init, RSCC %08x PDC %08x\n",
+	    rd(g_gmu, GMU_RSCC_OFF + RSCC_PDC_SLAVE_ID_DRV0 * 4u),
+	    rd(g_pdc, PDC_GPU_ENABLE_PDC * 4u));
+	return true;
+}
+
+static bool
+gmu_boot(void)
+{
+	gmu_wr(G_AO_HOST_INTERRUPT_CLR, 0xffffffffu);
+	gmu_wr(G_AO_HOST_INTERRUPT_MASK, 0xffffffffu);
+	gmu_wr(G_GMU2HOST_INTR_CLR, 0xffffffffu);
+	gmu_wr(G_GMU2HOST_INTR_MASK, 0xffffffffu);
+
+	g_dummy_pa = gpu_page(&g_dummy_va);
+	g_dbg_pa = gpu_alloc(&g_dbg_va, 0x4000);
+	g_log_pa = gpu_alloc(&g_log_va, 0x4000);
+	g_hfi_pa = gpu_alloc(&g_hfi_va, 0x4000);
+	if (g_dummy_pa == 0 || g_dbg_pa == 0 || g_log_pa == 0 || g_hfi_pa == 0) {
+		printf("SWEET GPU: GMU buffer allocation failed\n");
+		return false;
+	}
+	g_dbg_iova = GMU_DEBUG_IOVA;
+	g_hfi_iova = GMU_HFI_IOVA;
+	g_log_iova = GMU_LOG_IOVA;
+	if (!gmu_smmu_map(GMU_DUMMY_IOVA, g_dummy_pa, 0x1000, false) ||
+	    !gmu_smmu_map(g_dbg_iova, g_dbg_pa, 0x4000, false) ||
+	    !gmu_smmu_map(g_hfi_iova, g_hfi_pa, 0x4000, false) ||
+	    !gmu_smmu_map(g_log_iova, g_log_pa, 0x4000, false)) {
+		printf("SWEET GPU: GMU IOVA map failed (dummy %llx dbg %llx log %llx hfi %llx)\n",
+		    g_dummy_pa, g_dbg_pa, g_log_pa, g_hfi_pa);
+		return false;
+	}
+	printf("SWEET GPU: GMU debug %llx log %llx hfi %llx, IOVA %x/%x/%x\n",
+	    g_dbg_pa, g_log_pa, g_hfi_pa, (uint32_t)g_dbg_iova,
+	    (uint32_t)g_log_iova, (uint32_t)g_hfi_iova);
+	hfi_init();
+
+	if (!arc_votes()) {
+		return false;
+	}
+
+	gmu_wr(G_GENERAL_7, 1);
+	if (!g_rpmh_done) {
+		if (!gmu_rpmh_init()) {
+			return false;
+		}
+		g_rpmh_done = true;
+	}
+	if (!gmu_load_fw()) {
+		return false;
+	}
+
+	gmu_wr(G_CM3_FW_INIT_RESULT, 0);
+	gmu_wr(G_CM3_BOOT_CONFIG, 0x02);
+	gmu_wr(G_HFI_QTBL_ADDR, (uint32_t)g_hfi_iova);
+	gmu_wr(G_HFI_QTBL_INFO, 1);
+	gmu_wr(G_AHB_FENCE_RANGE_0, (1u << 31) | (0xau << 18) | 0xa0u);
+	gmu_wr(G_CM3_CFG, 0x4052);
+	gmu_wr(G_HFI_SFR_ADDR, 0x06030200);
+	gmu_wr(G_PWR_COL_CP_MSG, (uint32_t)g_log_iova | 3u);
+
+	gmu_wr(G_SYS_BUS_CONFIG, 1);
+	gmu_wr(G_ICACHE_CONFIG, 1);
+	gmu_wr(G_DCACHE_CONFIG, 1);
+	gmu_wr(G_PWR_COL_INTER_FRAME_CTRL, 0x9c40400);
+	gmu_rmw(G_RPMH_CTRL, 0xf11u, 0xf11u);
+
+	if (!gmu_start()) {
+		return false;
+	}
+	if (!gmu_gfx_rail_on()) {
+		return false;
+	}
+	if (!gmu_sptprac_enable()) {
+		return false;
+	}
+	return gmu_hfi_start();
+}
+
+/* The ring: one 16 KB page (4096 dwords), wraps; rb_n is the next slot. */
+#define RB_DWORDS 4096u
+
+static void
+emit(uint32_t v)
+{
+	rb[rb_n] = v;
+	rb_n = (rb_n + 1) & (RB_DWORDS - 1);
+}
+
+static bool
+kick(void)
+{
+	flush_dcache64((addr64_t)rb_pa, PAGE_SIZE, TRUE);
+	gw(R_CP_RB_WPTR, rb_n);
+	uint64_t deadline;
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &deadline);
+	while (gr(R_CP_RB_RPTR) != rb_n) {
+		if (mach_absolute_time() > deadline) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+cp_state(const char *when)
+{
+	printf("SWEET GPU: %s RBBM_STATUS %08x RPTR %u WPTR %u CP_HW_FAULT %08x "
+	    "CP_INT %08x RBBM_INT %08x\n", when, gr(R_RBBM_STATUS), gr(R_CP_RB_RPTR),
+	    gr(R_CP_RB_WPTR), gr(R_CP_HW_FAULT), gr(R_CP_INTERRUPT_STATUS),
+	    gr(R_RBBM_INT_0_STATUS));
+}
+
+static void
+smmu_faults(const char *when)
+{
+	for (unsigned n = 0; n < 2; n++) {
+		vm_offset_t cb = g_smmu + SMMU_CB(n);
+		uint32_t fsr = rd(cb, SMMU_CB_FSR);
+		if (fsr != 0) {
+			printf("SWEET GPU: %s SMMU sGFSR %08x CB%u FSR %08x FAR %08x%08x FSYNR0 %08x\n",
+			    when, rd(g_smmu, 0x48), n, fsr, rd(cb, SMMU_CB_FAR + 4),
+			    rd(cb, SMMU_CB_FAR), rd(cb, SMMU_CB_FSYNR0));
+			wr(cb, SMMU_CB_FSR, 0xffffffffu);
+		}
+	}
+}
+
+static bool
+gpu_idle(void)
+{
+	for (unsigned i = 0; i < 1000; i++) {
+		uint32_t st = gr(R_RBBM_STATUS);
+		uint32_t irq = gr(R_RBBM_INT_0_STATUS);
+		if ((st & ~1u) == 0 && (irq & 0x00800000u) == 0) {
+			return true;
+		}
+		delay(1000);
+	}
+	return false;
+}
+
+/*
+ * Qualcomm SCM call (qcom_scm-smc.c): SMC64, SIP owner, fn (svc << 8) | cmd.
+ * TZ may return INTERRUPTED (1: retry with x0 = 1, x6 as returned) or EBUSY
+ * (-12: retry later).  Returns x0 (0 = ok); *r1 = x1.
+ */
+static int64_t
+scm_call(uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a, uint64_t b,
+    uint64_t c, uint64_t *r1)
+{
+	uint64_t fn = (1ull << 30) | (2ull << 24) | ((uint64_t)svc << 8) | cmd;
+	for (int busy = 0;; busy++) {
+		uint64_t a0 = fn, a6 = 0;
+		register uint64_t x0 __asm__("x0"), x1 __asm__("x1"), x2 __asm__("x2"), x3 __asm__("x3");
+		register uint64_t x4 __asm__("x4"), x5 __asm__("x5"), x6 __asm__("x6"), x7 __asm__("x7");
+		do {
+			x0 = a0; x1 = arginfo; x2 = a; x3 = b; x4 = c; x5 = 0; x6 = a6; x7 = 0;
+			__asm__ volatile("smc #0"
+			    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+			    :
+			    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			a0 = 1;
+			a6 = x6;
+		} while (x0 == 1);
+		if ((int64_t)x0 != -12 || busy >= 20) {
+			if (r1) {
+				*r1 = x1;
+			}
+			return (int64_t)x0;
+		}
+		delay(30000);
+	}
+}
+
+/*
+ * Zap shader from the squashed GPU-ZAP ELF.  Metadata is the ELF header
+ * segment (phdr[0].p_filesz bytes, which includes the program headers) plus
+ * the hash segment, as qcom_mdt_read_metadata() builds it; the image is
+ * relocated to the sdm845 gpu_mem carveout and authenticated with the GPU
+ * PAS id.  All segments are copied because a630_zap has more than one.
+ */
+static bool
+zap_load(void)
+{
+	uint64_t zap;
+	uint32_t zap_len;
+	if (!blob("GPU-ZAP", &zap, &zap_len) || zap_len < 0x34) {
+		return false;
+	}
+	const uint8_t *fw = (const uint8_t *)phystokv(zap);
+	if (fw[0] != 0x7f || fw[1] != 'E' || fw[2] != 'L' || fw[3] != 'F' || fw[4] != 1) {
+		printf("SWEET GPU: GPU-ZAP is not an ELF32 image\n");
+		return false;
+	}
+	uint32_t phoff = le32(fw + 0x1c);
+	uint16_t phentsize = le16(fw + 0x2a), phnum = le16(fw + 0x2c);
+	if (phentsize < sizeof(struct zap_phdr) || phnum == 0 ||
+	    (uint64_t)phoff + (uint64_t)phnum * phentsize > zap_len) {
+		printf("SWEET GPU: zap phdrs bad: off %x entsize %u num %u len %u\n",
+		    phoff, phentsize, phnum, zap_len);
+		return false;
+	}
+	const struct zap_phdr *ph = (const struct zap_phdr *)(fw + phoff);
+
+	uint32_t ehdr_size = ph[0].filesz, hash_seg = 0, hash_size = 0;
+	for (unsigned i = 0; i < phnum; i++) {
+		if (((ph[i].flags >> 24) & 7) == 2 && ph[i].filesz != 0) {
+			hash_seg = i;
+			hash_size = ph[i].filesz;
+			break;
+		}
+	}
+	if (hash_size == 0) {
+		printf("SWEET GPU: zap has no hash segment\n");
+		return false;
+	}
+	uint32_t hash_off = ph[hash_seg].offset;
+	if (hash_off + hash_size > zap_len) {
+		hash_off = ehdr_size;
+	}
+	if ((uint64_t)ehdr_size + hash_size > PAGE_SIZE || hash_off + hash_size > zap_len) {
+		printf("SWEET GPU: zap metadata bad: ehdr %u hash %u/%u len %u\n",
+		    ehdr_size, hash_off, hash_size, zap_len);
+		return false;
+	}
+
+	bool relocate = false;
+	uint32_t min_pa = 0xffffffffu, max_end = 0;
+	for (unsigned i = 0; i < phnum; i++) {
+		if (ph[i].type != 1 || ((ph[i].flags >> 24) & 7) == 2 || ph[i].memsz == 0) {
+			continue;
+		}
+		if (ph[i].flags & (1u << 27)) {
+			relocate = true;
+		}
+		min_pa = MIN(min_pa, ph[i].paddr);
+		max_end = MAX(max_end, ph[i].paddr + ph[i].memsz);
+	}
+	if (min_pa == 0xffffffffu || max_end < min_pa) {
+		printf("SWEET GPU: zap has no loadable segment\n");
+		return false;
+	}
+	uint32_t img_size = (max_end + 0xfffu) & ~0xfffu;
+	img_size -= min_pa;
+	if (img_size > ZAP_SIZE) {
+		printf("SWEET GPU: zap image %u bytes > carveout %u\n", img_size, ZAP_SIZE);
+		return false;
+	}
+	uint32_t mem_reloc = relocate ? min_pa : ZAP_PA;
+
+	vm_offset_t meta_va;
+	uint64_t meta = gpu_page(&meta_va);
+	if (meta == 0) {
+		return false;
+	}
+	uint8_t *mv = (uint8_t *)meta_va;
+	memcpy(mv, fw, ehdr_size);
+	memcpy(mv + ehdr_size, fw + hash_off, hash_size);
+	flush_dcache64((addr64_t)meta, PAGE_SIZE, TRUE);
+
+	uint64_t r1 = 0;
+	int64_t r = scm_call(2, 1, 2u | (2u << 6), GPU_PAS_ID, meta, 0, &r1);
+	printf("SWEET GPU: zap init_image (meta %llx, %u bytes) -> %lld/%llx\n",
+	    meta, ehdr_size + hash_size, r, r1);
+	if (r != 0 || r1 != 0) {
+		return false;
+	}
+	if (relocate) {
+		r = scm_call(2, 2, 3, GPU_PAS_ID, ZAP_PA, img_size, &r1);
+		printf("SWEET GPU: zap mem_setup %x + %x -> %lld/%llx\n",
+		    (uint32_t)ZAP_PA, img_size, r, r1);
+		if (r != 0 || r1 != 0) {
+			return false;
+		}
+	}
+
+	vm_offset_t target = ml_io_map(ZAP_PA, ZAP_SIZE);
+	if (target == 0) {
+		printf("SWEET GPU: cannot map the zap carveout\n");
+		return false;
+	}
+	for (unsigned i = 0; i < phnum; i++) {
+		if (ph[i].type != 1 || ((ph[i].flags >> 24) & 7) == 2 || ph[i].memsz == 0) {
+			continue;
+		}
+		if (ph[i].paddr < mem_reloc || ph[i].filesz > ph[i].memsz ||
+		    (uint64_t)ph[i].offset + ph[i].filesz > zap_len) {
+			printf("SWEET GPU: zap segment %u bad: pa %x reloc %x filesz %u memsz %u\n",
+			    i, ph[i].paddr, mem_reloc, ph[i].filesz, ph[i].memsz);
+			return false;
+		}
+		uint32_t off = ph[i].paddr - mem_reloc;
+		if ((uint64_t)off + ph[i].memsz > ZAP_SIZE) {
+			printf("SWEET GPU: zap segment %u outside carveout (%x + %x)\n",
+			    i, off, ph[i].memsz);
+			return false;
+		}
+		for (uint32_t b = 0; b < ph[i].memsz; b += 4) {
+			uint32_t v = 0;
+			for (unsigned k = 0; k < 4; k++) {
+				if (b + k < ph[i].filesz) {
+					v |= (uint32_t)fw[ph[i].offset + b + k] << (8 * k);
+				}
+			}
+			wr(target, off + b, v);
+		}
+	}
+	r = scm_call(2, 5, 1, GPU_PAS_ID, 0, 0, &r1);
+	printf("SWEET GPU: zap auth_and_reset -> %lld/%llx\n", r, r1);
+	return r == 0 && r1 == 0;
+}
+/* A6XX_TEX_CONST (16 dwords) for a linear 2-D image; swizzle x first. */
+#define FMT6_8_UNORM		3u
+#define FMT6_8_8_UNORM		15u
+#define FMT6_8_8_8_8_UNORM	48u
+#define FMT6_32_UINT		75u
+#define SWIZ_XYZW		0x688u
+
+static void
+tex_desc6(uint32_t *t, uint64_t pa, uint32_t w, uint32_t h, uint32_t pitch,
+    uint32_t fmt, uint32_t swiz)
+{
+	memset(t, 0, 16 * 4);
+	t[0] = ((swiz & 7) << 4) | (((swiz >> 3) & 7) << 7) |
+	    (((swiz >> 6) & 7) << 10) | (((swiz >> 9) & 7) << 13) | (fmt << 22);
+	t[1] = (w & 0x7fff) | ((h & 0x7fff) << 15);
+	t[2] = (pitch << 7) | (1u << 4) | (1u << 29);	/* pitch, 1 texel, 2D */
+	t[3] = ((pitch * h) >> 12) & 0x3fff;		/* array pitch */
+	t[4] = (uint32_t)pa & ~0x1fu;			/* base lo, 32-byte */
+	t[5] = (uint32_t)(pa >> 32) | (1u << 17);	/* base hi, depth 1 */
+}
+
+static void
+tex_rgba8_6(uint32_t *t, uint64_t pa, uint32_t w, uint32_t h, uint32_t pitch)
+{
+	tex_desc6(t, pa, w, h, pitch, FMT6_8_8_8_8_UNORM, SWIZ_XYZW);
+}
+
+/* A6XX_TEX_SAMP: unnormalized coords, clamp to edge, linear or nearest. */
+static void
+samp6(uint32_t *s, bool linear)
+{
+	uint32_t f = linear ? 1 : 0;
+	s[0] = (f << 1) | (f << 3) | (1u << 5) | (1u << 8) | (1u << 11);
+	s[1] = (1u << 5) | (32u << 8);
+	s[2] = 0;
+	s[3] = 0;
+}
+
+/* A6XX IBO descriptor (16 dwords), size in dwords like Mesa buf_sizes. */
+static void
+ibo_desc6(uint32_t *d, uint64_t pa, uint32_t bytes)
+{
+	uint32_t sz = bytes >> 2;
+	memset(d, 0, 16 * 4);
+	d[0] = FMT6_32_UINT;				/* TILE6_LINEAR */
+	d[1] = (sz & 0x7fffu) | ((sz >> 15) << 15);
+	d[2] = (1u << 4) | (4u << 29);			/* buffer type */
+	d[4] = (uint32_t)pa & ~0x1fu;
+	d[5] = (uint32_t)(pa >> 32);
+}
+
+struct cs_extra {
+	const uint32_t *consts;		/* nconst vec4s at c0 */
+	uint32_t nconst;
+	const uint32_t *tex;		/* ntex x 16 dwords */
+	const uint32_t *samp;		/* ntex x 4 dwords */
+	uint32_t ntex;
+	uint32_t groups_y;		/* 0 = 1 */
+	uint32_t ibo_bytes;
+};
+
+static uint32_t rb_free(void);
+
+/*
+ * One compute dispatch, following m23 computerator cs_program_emit /
+ * cs_const_emit / cs_ibo_emit for A6xx: program state, shader preload,
+ * constants, samplers, textures, one IBO descriptor, CP_SET_MARKER and
+ * HLSQ_CS_NDRANGE.  Ends with CACHE_FLUSH_TS writing seq to fence.
+ */
+static bool
+compute_run(const struct sweet_kernel *k, uint64_t shader_pa, uint32_t groups,
+    uint64_t fence, uint32_t seq, const struct cs_extra *x)
+{
+	uint32_t gy = x && x->groups_y ? x->groups_y : 1;
+	uint32_t ntex = x ? x->ntex : 0;
+	uint32_t nconst = x ? x->nconst : 0;
+	uint32_t nibo = k->num_bufs ? 1 : 0;
+	uint32_t ctrl = ((uint32_t)(k->max_reg + 1) << 7);
+	if (k->mergedregs) {
+		ctrl |= 1u << 31;
+	}
+
+	emit(pkt4(R_SP_MODE_CONTROL, 1)); emit(5);
+	emit(pkt4(R_SP_PERFCTR_ENABLE, 1)); emit(0x20);
+	emit(pkt4(R_SP_FLOAT_CNTL, 1)); emit(0);
+	emit(pkt4(R_HLSQ_INVALIDATE_CMD, 1)); emit(0xbf);
+	emit(pkt4(R_HLSQ_CS_CNTL, 1));
+	emit((k->constlen >> 2) | 0x100);
+	emit(pkt4(R_SP_CS_CONFIG, 2));
+	emit(0x100u | (ntex << 9) | (ntex << 17) | (nibo << 22));
+	emit(k->instrlen);
+	emit(pkt4(R_SP_CS_CTRL_REG0, 1)); emit(ctrl);
+	emit(pkt4(R_SP_CS_UNKNOWN_A9B1, 1)); emit(0x41);
+	emit(pkt4(R_HLSQ_CS_CNTL_0, 2)); emit(0x00fcfcc0); emit(0xfc);
+	emit(pkt4(R_SP_CS_OBJ_START, 2));
+	emit((uint32_t)shader_pa); emit((uint32_t)(shader_pa >> 32));
+	emit(pkt4(R_SP_CS_INSTRLEN, 1)); emit(k->instrlen);
+	emit(pkt4(R_SP_CS_OBJ_START, 2));
+	emit((uint32_t)shader_pa); emit((uint32_t)(shader_pa >> 32));
+
+	uint32_t preload = k->instrlen < 64 ? k->instrlen : 64;
+	emit(pkt7(CP_LOAD_STATE6_FRAG, 3));
+	emit((ST6_SHADER << 14) | (SS6_INDIRECT << 16) | (SB6_CS_SHADER << 18) |
+	    (preload << 22));
+	emit((uint32_t)shader_pa); emit((uint32_t)(shader_pa >> 32));
+
+	if (nconst) {
+		emit(pkt7(CP_LOAD_STATE6_FRAG, 3 + 4 * nconst));
+		emit((ST6_CONSTANTS << 14) | (SS6_DIRECT << 16) |
+		    (SB6_CS_SHADER << 18) | (nconst << 22));
+		emit(0); emit(0);
+		for (uint32_t i = 0; i < 4 * nconst; i++) {
+			emit(x->consts[i]);
+		}
+	}
+	if (ntex) {
+		emit(pkt7(CP_LOAD_STATE6_FRAG, 3 + 4 * ntex));
+		emit((ST6_SHADER << 14) | (SS6_DIRECT << 16) |
+		    (SB6_CS_TEX << 18) | (ntex << 22));
+		emit(0); emit(0);
+		for (uint32_t i = 0; i < 4 * ntex; i++) {
+			emit(x->samp[i]);
+		}
+		emit(pkt7(CP_LOAD_STATE6_FRAG, 3 + 16 * ntex));
+		emit((ST6_CONSTANTS << 14) | (SS6_DIRECT << 16) |
+		    (SB6_CS_TEX << 18) | (ntex << 22));
+		emit(0); emit(0);
+		for (uint32_t i = 0; i < 16 * ntex; i++) {
+			emit(x->tex[i]);
+		}
+		emit(pkt4(R_SP_CS_TEX_COUNT, 1)); emit(ntex);
+	}
+	if (nibo) {
+		emit(pkt7(CP_LOAD_STATE6_FRAG, 3));
+		emit((ST6_IBO << 14) | (SS6_INDIRECT << 16) |
+		    (SB6_CS_SHADER << 18) | (nibo << 22));
+		emit((uint32_t)g_ibo_pa); emit((uint32_t)(g_ibo_pa >> 32));
+		emit(pkt4(R_SP_CS_IBO, 2));
+		emit((uint32_t)g_ibo_pa); emit((uint32_t)(g_ibo_pa >> 32));
+		emit(pkt4(R_SP_CS_IBO_COUNT, 1)); emit(nibo);
+	}
+
+	emit(pkt7(CP_SET_MARKER, 1)); emit(RM6_COMPUTE);
+	emit(pkt4(R_HLSQ_CS_NDRANGE_0, 7));
+	emit(3u | ((k->local[0] - 1) << 2) | ((k->local[1] - 1) << 12) |
+	    ((k->local[2] - 1) << 22));
+	emit(k->local[0] * groups); emit(0);
+	emit(k->local[1] * gy); emit(0);
+	emit(k->local[2]); emit(0);
+	emit(pkt4(R_HLSQ_CS_KERNEL_GROUP_X, 3)); emit(1); emit(1); emit(1);
+	emit(pkt7(CP_EXEC_CS, 4)); emit(0); emit(groups); emit(gy); emit(1);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	emit(pkt7(CP_EVENT_WRITE, 4)); emit(CP_EVENT_CACHE_FLUSH_TS);
+	emit((uint32_t)fence); emit((uint32_t)(fence >> 32)); emit(seq);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	return kick();
+}
+
+/* The 4 KB page-table entry behind a GPU VA (0 outside the window). */
+static uint64_t
+gva_pte(uint64_t va)
+{
+	if (va < GVA_BASE || va - GVA_BASE >= (uint64_t)GVA_PAGES * PAGE_SIZE) {
+		return 0;
+	}
+	uint64_t i = (va - GVA_BASE) / 4096;
+	uint64_t *t = g_l3[i / 512];
+	return t != NULL ? t[i % 512] : 0;
+}
+
+/*
+ * The engine behind sweet_gpu_quad: validate, map cache, emit sample4, poll
+ * the fence.  Caller holds no lock.  g_ready is not checked so the level 3
+ * self-test can use it before service mode.
+ */
+static int
+quad_exec(const struct sweet_gpu_quad *q)
+{
+	static const uint32_t fmt_bpp[3] = { 4, 1, 2 };
+	static const uint32_t fmt_code[3] = {
+		FMT6_8_8_8_8_UNORM, FMT6_8_UNORM, FMT6_8_8_UNORM
+	};
+	uint32_t swiz = q->src_swiz;
+	bool swiz_ok = (swiz >> 12) == 0;
+	for (int c = 0; c < 4; c++) {
+		swiz_ok = swiz_ok && ((swiz >> (3 * c)) & 7) <= 5;
+	}
+	if (q->src_fmt > SWEET_GPU_FMT_RG8 || !swiz_ok || q->nedges > 4 ||
+	    q->src_w == 0 || q->src_h == 0 || q->src_w > 16384 || q->src_h > 16384 ||
+	    q->dst_w == 0 || q->dst_h == 0 || q->dst_w > 16384 || q->dst_h > 16384 ||
+	    q->src_pitch % 64 || q->dst_pitch % 64 ||
+	    q->src_pitch < q->src_w * fmt_bpp[q->src_fmt] ||
+	    q->dst_pitch < q->dst_w * 4 ||
+	    (q->src_va & 63) || (q->dst_va & 63) || q->w == 0 || q->h == 0 ||
+	    q->x0 >= q->dst_w || q->y0 >= q->dst_h ||
+	    q->w > q->dst_w - q->x0 || q->h > q->dst_h - q->y0 ||
+	    (q->flags & ~7u) || (q->flags & 6u) == 6u) {
+		return EINVAL;
+	}
+	uint64_t slen = (uint64_t)q->src_pitch * q->src_h;
+	uint64_t dlen = (uint64_t)q->dst_pitch * q->dst_h;
+	if (slen > 0xffffffffu || dlen > 0xffffffffu) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	int sf = vm_range(q->src_va, slen), df = vm_range(q->dst_va, dlen);
+	if (sf < 0 || df < 0 || g_maps[df].ro) {
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		return EFAULT;
+	}
+	uint64_t drow = q->dst_va + (uint64_t)q->y0 * q->dst_pitch;
+	uint64_t drows = (uint64_t)q->h * q->dst_pitch;
+	vm_cache((uint32_t)sf, q->src_va, slen);
+	vm_cache((uint32_t)df, drow, drows);
+
+	uint32_t xa = q->x0 & ~3u;
+	uint32_t groups = (q->x0 + q->w - xa + 3) / 4;
+	uint32_t consts[48] = {
+		q->m[0], q->m[1], q->m[2], q->m[3],
+		q->m[4], q->m[5], 0, 0x3f800000u,
+		0x437f0000u, 0x3f000000u, groups - 1, q->dst_pitch / 4,
+		xa, q->y0,
+		q->flags & (SWEET_GPU_QUAD_ADD | SWEET_GPU_QUAD_COPY) ? 0 : 0x3f800000u,
+		q->flags & SWEET_GPU_QUAD_COPY ? 0xbf800000u : 0,
+		q->x0, q->x0 + q->w, 0xbf800000u, 0,
+		q->color[0], q->color[1], q->color[2], q->color[3],
+	};
+	for (uint32_t e = 0; e < 4; e++) {
+		consts[24 + 4 * e] = e < q->nedges ? q->edge[e][0] : 0;
+		consts[25 + 4 * e] = e < q->nedges ? q->edge[e][1] : 0;
+		consts[26 + 4 * e] = e < q->nedges ? q->edge[e][2] : 0x3f800000u;
+	}
+	consts[40] = 0x49800000u;		/* K = 2^20 */
+
+	uint32_t tex[32], samp[8];
+	tex_desc6(tex, q->src_va, q->src_w, q->src_h, q->src_pitch,
+	    fmt_code[q->src_fmt], swiz);
+	tex_rgba8_6(tex + 16, q->dst_va, q->dst_pitch / 4, q->dst_h, q->dst_pitch);
+	samp6(samp, !(q->flags & SWEET_GPU_QUAD_NEAREST));
+	samp6(samp + 4, false);
+	ibo_desc6((uint32_t *)g_ibo_va, q->dst_va, (uint32_t)dlen);
+	flush_dcache64((addr64_t)g_ibo_pa, PAGE_SIZE, TRUE);
+
+	struct cs_extra x = { consts, 12, tex, samp, 2, q->h, 0 };
+	uint64_t room_deadline;
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &room_deadline);
+	while (rb_free() < 512 && mach_absolute_time() < room_deadline) {
+	}
+	uint32_t seq = ++g_seq;
+	volatile uint32_t *fv = (volatile uint32_t *)(g_scratch_va + 64);
+	bool read = compute_run(&k_sample4, g_ksample4_pa, (groups + 63) / 64,
+	    g_scratch + 64, seq, &x);
+	bool done = false;
+	uint64_t deadline;
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &deadline);
+	while (read && !(done = (*fv == seq)) && mach_absolute_time() < deadline) {
+		flush_dcache64((addr64_t)g_scratch + 64, 4, TRUE);
+	}
+	vm_cache((uint32_t)df, drow, drows);
+	if (!done) {
+		g_ready = false;
+		cp_state("quad timeout:");
+		smmu_faults("quad timeout:");
+		/* Every address this dispatch uses, to match against the SMMU FAR. */
+		uint32_t *ibo = (uint32_t *)g_ibo_va;
+		printf("SWEET GPU: quad pa: shader %llx ibo %llx ring %llx fence %llx\n",
+		    (unsigned long long)g_ksample4_pa, (unsigned long long)g_ibo_pa,
+		    (unsigned long long)rb_pa, (unsigned long long)(g_scratch + 64));
+		printf("SWEET GPU: quad va: src %llx+%llx pte %llx, dst %llx+%llx pte %llx, drow %llx\n",
+		    (unsigned long long)q->src_va, (unsigned long long)slen,
+		    (unsigned long long)gva_pte(q->src_va),
+		    (unsigned long long)q->dst_va, (unsigned long long)dlen,
+		    (unsigned long long)gva_pte(q->dst_va), (unsigned long long)drow);
+		printf("SWEET GPU: quad desc: tex %08x %08x, dst tex %08x %08x, ibo %08x %08x\n",
+		    tex[4], tex[5], tex[20], tex[21], ibo[4], ibo[5]);
+		printf("SWEET GPU: quad timed out, GPU service off until reboot\n");
+	}
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	return done ? 0 : ETIMEDOUT;
+}
+
+int
+sweet_gpu_quad(const struct sweet_gpu_quad *q)
+{
+	if (!g_ready) {
+		return ENXIO;
+	}
+	return quad_exec(q);
+}
+
+/* Ring dwords free (one slot stays empty: rptr == wptr means empty). */
+static uint32_t
+rb_free(void)
+{
+	return (gr(R_CP_RB_RPTR) - rb_n - 1) & (RB_DWORDS - 1);
+}
+
+static uint32_t g_fence_seen;
+static uint64_t g_fence_when;
+
+static uint32_t
+fence_now(void)
+{
+	if (g_fence_va == 0) {
+		return 0;
+	}
+	flush_dcache64((addr64_t)g_fence_pa, 64, TRUE);
+	return *(volatile uint32_t *)g_fence_va;
+}
+
+/* VM lock held: declare the GPU hung. */
+static void
+gpu_hung(const char *why)
+{
+	g_ready = false;
+	cp_state(why);
+	smmu_faults(why);
+	printf("SWEET GPU: %s: fence %u, submitted %u: GPU service off until reboot\n",
+	    why, fence_now(), g_submit_seq);
+}
+
+int
+sweet_gpu_submit(const struct sweet_gpu_ib *ib, uint32_t n, uint32_t *seqno)
+{
+	if (!g_ready || g_fence_va == 0) {
+		return ENXIO;
+	}
+	if (n == 0 || n > SWEET_GPU_MAX_IBS) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	int ret = 0;
+	for (uint32_t i = 0; i < n && ret == 0; i++) {
+		if (ib[i].dwords == 0 || ib[i].dwords > 0xfffffu || (ib[i].iova & 3)) {
+			ret = EINVAL;
+		} else if (vm_range(ib[i].iova, (uint64_t)ib[i].dwords * 4) < 0) {
+			ret = EFAULT;
+		}
+	}
+	smmu_faults("submit:");
+	uint32_t need = 4 * n + 5;
+	uint64_t deadline;
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &deadline);
+	while (ret == 0 && g_ready && rb_free() < need) {
+		if (mach_absolute_time() > deadline) {
+			gpu_hung("submit: ring full");
+			ret = ETIMEDOUT;
+		}
+	}
+	if (ret == 0 && !g_ready) {
+		ret = ENXIO;
+	}
+	if (ret == 0) {
+		for (uint32_t i = 0; i < n; i++) {
+			emit(pkt7(CP_INDIRECT_BUFFER_PFE, 3));
+			emit((uint32_t)ib[i].iova);
+			emit((uint32_t)(ib[i].iova >> 32));
+			emit(ib[i].dwords);
+		}
+		uint32_t seq = ++g_submit_seq;
+		emit(pkt7(CP_EVENT_WRITE, 4)); emit(CP_EVENT_CACHE_FLUSH_TS);
+		emit((uint32_t)g_fence_pa); emit((uint32_t)(g_fence_pa >> 32)); emit(seq);
+		flush_dcache64((addr64_t)rb_pa, PAGE_SIZE, TRUE);
+		gw(R_CP_RB_WPTR, rb_n);
+		*seqno = seq;
+	}
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	return ret;
+}
+
+int
+sweet_gpu_wait(uint32_t seqno, uint32_t timeout_ms)
+{
+	if (g_fence_va == 0) {
+		return ENXIO;
+	}
+	uint64_t deadline, spin_until;
+	clock_interval_to_deadline(timeout_ms, NSEC_PER_MSEC, &deadline);
+	clock_interval_to_deadline(2, NSEC_PER_MSEC, &spin_until);
+	for (;;) {
+		uint32_t f = fence_now();
+		if ((int32_t)(f - seqno) >= 0) {
+			return 0;
+		}
+		if (!g_ready) {
+			return ENXIO;
+		}
+		uint64_t now = mach_absolute_time();
+		lck_mtx_lock(&sweet_gpu_vm_lock);
+		if (f != g_fence_seen || g_fence_when == 0) {
+			g_fence_seen = f;
+			g_fence_when = now;
+		} else if (g_ready && f != g_submit_seq && usecs(now - g_fence_when) > 2000000) {
+			gpu_hung("wait: fence stuck 2 s");
+		}
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		if (now > deadline) {
+			return ETIMEDOUT;
+		}
+		if (now > spin_until) {
+			delay(200);
+		}
+	}
+}
+
+bool
+sweet_gpu_ready(void)
+{
+	return g_ready;
+}
+
+void
+sweet_gpu_set_fence_page(uintptr_t kva, uint64_t pa)
+{
+	g_fence_pa = pa;
+	g_fence_va = (vm_offset_t)kva;
+}
