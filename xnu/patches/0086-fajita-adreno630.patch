+/*
+ * GMU (SMMU stream 5) context bank 1: 4 KB-granule stage-1 page table.
+ * Mainline a6xx_gmu_memory_alloc() places a dummy page at 0x60000000 and
+ * allocates the debug (16 KB), HFI (16 KB) and log buffers upwards from
+ * 0x60001000; those are IOVAs, not physical addresses.
+ */
+#define GMU_IOVA_BASE		0x60000000u
+#define GMU_IOVA_END		0x80000000u
+#define GMU_DUMMY_IOVA		0x60000000u
+#define GMU_DEBUG_IOVA		(GMU_IOVA_BASE + 0x1000u)
+#define GMU_HFI_IOVA		(GMU_IOVA_BASE + 0x5000u)
+#define GMU_LOG_IOVA		(GMU_IOVA_BASE + 0x9000u)
