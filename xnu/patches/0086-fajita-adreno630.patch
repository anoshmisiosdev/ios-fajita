+#define SS6_DIRECT		0u
+#define SS6_INDIRECT		2u
+#define ST6_SHADER		0u
+#define ST6_CONSTANTS		1u
+#define ST6_IBO			3u
+#define SB6_CS_TEX		5u
+#define SB6_CS_SHADER		13u
+#define SB6_CS_IBO		15u
