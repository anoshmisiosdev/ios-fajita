+void
+sweet_gpu_get_info(struct sweet_gpu_info *info)
+{
+	*info = (struct sweet_gpu_info){
+		.chip_id = g_chipid,
+		.gmem_size = 0x100000u,
+		.gmem_base = 0x100000u,
