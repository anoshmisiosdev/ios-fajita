+#define GVA_BASE	0x200000000ull
+#define GVA_CHUNKS	4096u
+#define GVA_PAGES	((8ull * 1024 * 1024 * 1024) / PAGE_SIZE)
+#define VM_MAPS		16384u
+#define VM_GUARD	0xffffu
+#define VM_PAD		8u
+#define PTE_ATTRS	((1ull << 6) | (2ull << 8) | (1ull << 10))
