+/*
+ * USB reset or disconnect (Linux dwc3_gadget_reset_interrupt /
+ * _disconnect_interrupt): end the outstanding transfers, clear stalls,
+ * drop the data endpoints and the configuration, and put ep0 back in the
+ * SETUP stage. Without this a host-side reset (or unplug + replug) left
+ * ep0 waiting in a data/status stage and the bulk endpoints configured,
+ * and the phone never enumerated again until reboot.
+ */
+static void
+ud_bus_reset(const char *why)
+{
+	static const unsigned data_eps[] = { EP_RX, EP_TX, EP_INT };
+	bool was = ud.configured;
+
+	lck_mtx_lock(ud.lock);
+	ud.configured = false;          /* stops ud_tx_kick_locked */
+	for (unsigned i = 0; i < 3; i++) {
+		unsigned ep = data_eps[i];
+		if (ud.xfer_active[ep]) {
+			ud_epcmd(ep, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.xfer_res[ep] << 16), 0, 0, 0);
+			ud.xfer_active[ep] = false;
+		}
+		ud_epcmd(ep, DEPCMD_CLEARSTALL, 0, 0, 0);
+	}
+	ud.tx_busy = false;
+	lck_mtx_unlock(ud.lock);
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & 3u);
+	if (ud.xfer_active[1]) {        /* an IN data/status stage on ep0 */
+		ud_epcmd(1, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.xfer_res[1] << 16), 0, 0, 0);
+		ud.xfer_active[1] = false;
+	}
+	ud.data_alt = 0;
+	ud.notify_stage = 0;
+	if (ud.state != EP0_SETUP || !ud.xfer_active[0]) {
+		if (ud.xfer_active[0]) {
+			ud_epcmd(0, DEPCMD_ENDTRANSFER | DEPCMD_FORCERM | ((uint32_t)ud.xfer_res[0] << 16), 0, 0, 0);
+			ud.xfer_active[0] = false;
+		}
+		ud_start_setup();
+	}
+	if (was) {
+		ud_link_event(false);
+	}
+	ud.resets++;
+	printf("SWEET USB: %s #%u: endpoints reset, ep0 back to SETUP (was %s)\n",
+	    why, ud.resets, was ? "configured" : "unconfigured");
+}
