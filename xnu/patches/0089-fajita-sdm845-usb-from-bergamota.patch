+		return;
+	}
+	/* The block replicates each 8-bit register across the 32-bit word. */
+	uint32_t pwr = usb_rd(phy, QUSB2_PWR_CTRL1) & 0xff, pll = usb_rd(phy, QUSB2_PLL_STATUS) & 0xff;
+	printf("SWEET USB FIX: QUSB2 PWR_CTRL1 0x%02x PLL_STATUS 0x%02x before\n", pwr, pll);
+	if (pwr & QUSB2_PWR_DOWN) {
+		*(volatile uint32_t *)(phy + QUSB2_PWR_CTRL1) = (pwr & ~QUSB2_PWR_DOWN) | QUSB2_CLAMP_N_EN;
+		__asm__ volatile ("dsb sy" ::: "memory");
+		delay(250);                 /* Linux: wait 250 us for the PLL to lock */
+	}
+	int i;
+	for (i = 0; i < 1000 && !(usb_rd(phy, QUSB2_PLL_STATUS) & QUSB2_PLL_LOCKED); i++) {
+		delay(1);
+	}
+	printf("SWEET USB FIX: QUSB2 PWR_CTRL1 0x%02x PLL_STATUS 0x%02x after (%s, %d us)\n",
+	    usb_rd(phy, QUSB2_PWR_CTRL1) & 0xff, usb_rd(phy, QUSB2_PLL_STATUS) & 0xff,
