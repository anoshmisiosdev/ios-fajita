+/* ---- RMI4 transport: 8-bit register address within a 256-byte page ---- */
+
+static int
+rmi_set_page(unsigned page)
+{
+	if ((int)page == st.page) {
+		return 0;
+	}
+	const uint8_t tx[2] = {RMI_PAGE_SELECT, (uint8_t)page};
+	int err = touch_msg(TOUCH_ADDR, tx, sizeof(tx), NULL, 0, false);
+	st.page = err ? -1 : (int)page;
+	return err;
+}
+
+/* At most 90 bytes per read (the FIFO message limit above). */
+static int
+rmi_read(uint16_t addr, uint8_t *buf, unsigned len)
+{
+	int err = rmi_set_page(addr >> 8);
+	if (!err) {
+		err = touch_read(TOUCH_ADDR, addr & 0xffu, false, buf, len);
+	}
+	if (err) {
+		st.page = -1; /* re-select after any failure */
+	}
+	return err;
+}
+
+static int
+rmi_write(uint16_t addr, uint8_t value)
+{
+	int err = rmi_set_page(addr >> 8);
+	if (!err) {
+		const uint8_t tx[2] = {(uint8_t)addr, value};
+		err = touch_msg(TOUCH_ADDR, tx, sizeof(tx), NULL, 0, false);
+	}
+	if (err) {
+		st.page = -1;
+	}
+	return err;
+}
+
+/*
+ * Page Description Table scan (rmi_driver.c rmi_scan_pdt_page). Duplicate
+ * entries are ignored: the first F01/F12 wins (some S3706B firmware lists
+ * functions twice, see the 2026 "add quirks for third party touchscreen
+ * controllers" series).
+ */
+static bool
+rmi_scan_pdt(void)
+{
+	bool f34_boot = false;
+	for (unsigned page = 0; page < RMI_PAGES; ++page) {
+		unsigned base = page * 0x100u, found = 0;
+		/* signed: the scan steps below RMI_PDT_END before it stops */
+		for (int a = RMI_PDT_START; a >= (int)RMI_PDT_END; a -= (int)RMI_PDT_ENTRY) {
+			uint8_t e[RMI_PDT_ENTRY];
+			if (rmi_read((uint16_t)(base + a), e, sizeof(e))) {
+				printf("SWEET TOUCH: PDT read failed page %u addr %#x\n", page, (unsigned)a);
+				return false;
+			}
+			if (e[5] == 0 || e[5] == 0xff) {
+				break;
+			}
+			++found;
+			printf("SWEET TOUCH: PDT page %u F%02x query=%#x ctrl=%#x data=%#x cmd=%#x irqs=%u ver=%u\n",
+			    page, e[5], base + e[0], base + e[2], base + e[3], base + e[1],
+			    e[4] & 7u, (e[4] >> 5) & 3u);
+			if (e[5] == 0x01 && !st.f01_ctrl) {
+				st.f01_query = (uint16_t)(base + e[0]);
+				st.f01_ctrl = (uint16_t)(base + e[2]);
+				st.f01_data = (uint16_t)(base + e[3]);
+			} else if (e[5] == 0x12 && !st.f12_data) {
+				st.f12_query = (uint16_t)(base + e[0]);
+				st.f12_ctrl = (uint16_t)(base + e[2]);
+				st.f12_data = (uint16_t)(base + e[3]);
+			} else if (e[5] == 0x34 && ((e[4] >> 5) & 3u) > 1) {
+				uint8_t status = 0;
+				if (!rmi_read((uint16_t)(base + e[3]), &status, 1) && (status & 0x40u)) {
+					f34_boot = true; /* rmi_check_bootloader_mode */
+				}
+			}
+		}
+		if (!found && page > 0) {
+			break; /* empty page: end of PDT */
+		}
+	}
+	if (f34_boot) {
+		printf("SWEET TOUCH: controller is in its bootloader (no firmware?); stopping\n");
+		return false;
+	}
+	return st.f01_ctrl && st.f12_data;
+}
+
+/* rmi_driver.c rmi_read_register_desc + rmi_parse_register_desc_item */
+static bool
+rmi_read_desc(uint16_t addr, struct rmi_desc *d)
+{
+	uint8_t size_presence = 0, pres[35], sbuf[90];
+	d->n = 0;
+	if (rmi_read(addr, &size_presence, 1) || size_presence < 1 || size_presence > sizeof(pres)) {
+		return false;
+	}
+	memset(pres, 0, sizeof(pres));
+	if (rmi_read((uint16_t)(addr + 1), pres, size_presence)) {
+		return false;
+	}
+	unsigned off, struct_size;
+	if (pres[0] == 0) {
+		if (size_presence < 3) {
+			return false;
+		}
+		struct_size = pres[1] | ((unsigned)pres[2] << 8);
+		off = 3;
+	} else {
+		struct_size = pres[0];
+		off = 1;
+	}
+	if (struct_size == 0 || struct_size > sizeof(sbuf) ||
+	    rmi_read((uint16_t)(addr + 2), sbuf, struct_size)) {
+		return false;
+	}
+	unsigned map = 0, pos = 0;
+	for (unsigned i = off; i < size_presence; ++i) {
+		for (unsigned b = 0; b < 8; ++b, ++map) {
+			if (!(pres[i] & (1u << b))) {
+				continue;
+			}
+			if (pos >= struct_size || d->n >= RMI_REGS_MAX) {
+				return d->n != 0;
+			}
+			unsigned size = sbuf[pos++];
+			if (size == 0) {
+				if (pos + 2 > struct_size) {
+					return false;
+				}
+				size = sbuf[pos] | ((unsigned)sbuf[pos + 1] << 8);
+				pos += 2;
+			}
+			if (size == 0) {
+				if (pos + 4 > struct_size) {
+					return false;
+				}
+				size = sbuf[pos] | ((unsigned)sbuf[pos + 1] << 8) |
+				    ((unsigned)sbuf[pos + 2] << 16) | ((unsigned)sbuf[pos + 3] << 24);
+				pos += 4;
+			}
+			unsigned subs = 0;
+			bool sub0 = false, more;
+			unsigned bit = 0;
+			do {
+				if (pos >= struct_size) {
+					return false;
+				}
+				uint8_t v = sbuf[pos++];
+				for (unsigned k = 0; k < 7; ++k, ++bit) {
+					if (v & (1u << k)) {
+						++subs;
+						if (bit == 0) {
+							sub0 = true;
+						}
+					}
+				}
+				more = (v & 0x80u) != 0;
+			} while (more);
+			if (size == 0 || size > 0xffffu) {
+				continue; /* Linux ignores zero-size registers too */
+			}
+			struct rmi_reg *r = &d->r[d->n++];
+			r->reg = (uint8_t)map;
+			r->size = (uint16_t)size;
+			r->subpackets = (uint8_t)(subs > 255 ? 255 : subs);
+			r->sub0 = sub0;
+		}
+	}
+	return true;
+}
+
+static const struct rmi_reg *
+rmi_desc_find(const struct rmi_desc *d, unsigned reg, unsigned *index, unsigned *bytes)
+{
+	unsigned b = 0;
+	for (unsigned i = 0; i < d->n; ++i) {
+		if (d->r[i].reg == reg) {
+			if (index) {
+				*index = i;     /* register address offset (one address per register) */
+			}
+			if (bytes) {
+				*bytes = b;     /* byte offset within a block read from the base */
+			}
+			return &d->r[i];
+		}
+		b += d->r[i].size;
+	}
+	return NULL;
+}
+
+/* F01: stay awake (syna,nosleep-mode = 1) and mark the device configured. */
+static void
+rmi_f01_setup(void)
+{
+	uint8_t pid[11] = {0}, ctrl0 = 0, status = 0;
+	if (!rmi_read((uint16_t)(st.f01_query + 11u), pid, 10)) {
+		printf("SWEET TOUCH: F01 product id '%s'\n", (const char *)pid);
+	}
+	(void)rmi_read(st.f01_data, &status, 1);
+	if (rmi_read(st.f01_ctrl, &ctrl0, 1)) {
+		printf("SWEET TOUCH: F01 ctrl0 read failed\n");
+		return;
+	}
+	uint8_t want = (uint8_t)((ctrl0 & ~3u) | F01_CTRL0_NOSLEEP | F01_CTRL0_CONFIGURED);
+	int err = want == ctrl0 ? 0 : rmi_write(st.f01_ctrl, want);
+	printf("SWEET TOUCH: F01 status=%#x ctrl0 %#x -> %#x err=%d\n", status, ctrl0, want, err);
+}
+
+/*
+ * F12 (rmi_f12.c rmi_f12_probe): query0 bit 0 says register descriptors
+ * exist; then query/control/data descriptors follow, 3 addresses apart.
+ * Control register 8 subpacket 0 holds max_x/max_y; data register 1 holds
+ * 8 bytes per object: type, x lo/hi, y lo/hi, z, wx, wy.
+ */
+static void
+rmi_f12_setup(void)
+{
+	static struct rmi_desc qd, cd, dd;
+	uint8_t q0 = 0;
+	unsigned idx = 0, bytes = 0;
+	const struct rmi_reg *ctrl8 = NULL, *data1 = NULL;
+
+	st.fallback = true;
+	st.objects = TOUCH_MAX;
+	st.data1_addr = st.f12_data;
+	st.max_x = PANEL_W - 1;
+	st.max_y = PANEL_H - 1;
+	if (rmi_read(st.f12_query, &q0, 1) || !(q0 & 1u)) {
+		printf("SWEET TOUCH: F12 query0=%#x: no register descriptors; fallback layout\n", q0);
+		return;
+	}
+	uint16_t q = (uint16_t)(st.f12_query + 1u);
+	if (!rmi_read_desc(q, &qd) || !rmi_read_desc((uint16_t)(q + 3u), &cd) ||
+	    !rmi_read_desc((uint16_t)(q + 6u), &dd)) {
+		printf("SWEET TOUCH: F12 descriptors unreadable; fallback layout\n");
+		return;
+	}
+	printf("SWEET TOUCH: F12 descriptors: %u query, %u control, %u data registers\n",
+	    qd.n, cd.n, dd.n);
+	ctrl8 = rmi_desc_find(&cd, 8, &idx, NULL);
+	if (ctrl8 && ctrl8->sub0 && ctrl8->size >= 4 && ctrl8->size <= 15) {
+		uint8_t b[15];
+		if (!rmi_read((uint16_t)(st.f12_ctrl + idx), b, ctrl8->size)) {
+			unsigned mx = b[0] | ((unsigned)b[1] << 8), my = b[2] | ((unsigned)b[3] << 8);
+			if (mx >= 100 && my >= 100) {
+				st.max_x = mx;
+				st.max_y = my;
+			}
+		}
+	}
+	data1 = rmi_desc_find(&dd, 1, &idx, &bytes);
+	if (data1 == NULL || data1->subpackets == 0) {
+		printf("SWEET TOUCH: F12 has no data1 (objects); fallback layout\n");
+		return;
+	}
+	st.objects = data1->subpackets;
+	if (st.objects * F12_OBJ_BYTES > data1->size) {
+		st.objects = data1->size / F12_OBJ_BYTES;
+	}
+	if (st.objects > TOUCH_MAX) {
+		st.objects = TOUCH_MAX;
+	}
+	/*
+	 * As Linux: one block read from the data base, data1 at its byte
+	 * offset. If the registers before it make that read too long for one
+	 * FIFO message, read data1 by its own register address instead.
+	 */
+	if (bytes + st.objects * F12_OBJ_BYTES <= TOUCH_READ_MAX) {
+		st.data1_addr = st.f12_data;
+		st.data1_skip = bytes;
+	} else {
+		st.data1_addr = (uint16_t)(st.f12_data + idx);
+		st.data1_skip = 0;
+	}
+	st.fallback = false;
+	printf("SWEET TOUCH: F12 data1 read at %#x skip %u (index %u, byte %u) %u objects, max %ux%u\n",
+	    st.data1_addr, st.data1_skip, idx, bytes, st.objects, st.max_x, st.max_y);
+}
+
+static int
+touch_rmi_poll(void)
+{
+	uint8_t buf[TOUCH_READ_MAX], irq[2];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	/* Reading F01's interrupt status releases the attention line. */
+	(void)rmi_read((uint16_t)(st.f01_data + 1u), irq, sizeof(irq));
+	int err = rmi_read(st.data1_addr, buf, st.data1_skip + st.objects * F12_OBJ_BYTES);
+	if (err) {
+		return err;
+	}
+	for (unsigned i = 0; i < st.objects; ++i) {
+		const uint8_t *p = buf + st.data1_skip + i * F12_OBJ_BYTES;
+		if (p[0] != F12_OBJ_FINGER) {
+			continue; /* none, stylus, palm, unclassified */
+		}
+		unsigned rx = p[1] | ((unsigned)p[2] << 8), ry = p[3] | ((unsigned)p[4] << 8);
+		if (rx > st.max_x || ry > st.max_y) {
+			continue;
+		}
+		mask |= 1u << i;
+		x[i] = (int)((uint64_t)rx * (PANEL_W - 1) / st.max_x);
+		y[i] = (int)((uint64_t)ry * (PANEL_H - 1) / st.max_y);
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
