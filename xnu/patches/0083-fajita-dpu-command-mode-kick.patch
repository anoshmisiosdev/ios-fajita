+void
+AppleCLCD::dpuSetup(void)
+{
+	int mode = 1;
+	PE_parse_boot_argn("fajita_dpu", &mode, sizeof(mode));
+	if (mode == 0) {
+		IOLog("FAJITA DPU: left alone (fajita_dpu=0)\n");
+		return;
+	}
+	/* Never touch a gated block: an access to it hangs the bus. */
+	vm_offset_t cc = ml_io_map(FAJITA_DISPCC_PA, 0x10000);
+	if (cc == 0) {
+		IOLog("FAJITA DPU: dispcc map failed\n");
+		return;
+	}
+	uint32_t gdsc = *(volatile uint32_t *)(cc + FAJITA_DISPCC_MDSS_GDSCR);
+	uint32_t mdp = *(volatile uint32_t *)(cc + FAJITA_DISPCC_MDP_CBCR);
+	uint32_t ahb = *(volatile uint32_t *)(cc + FAJITA_DISPCC_AHB_CBCR);
+	IOLog("FAJITA DPU: MDSS GDSC 0x%08x MDP CBCR 0x%08x AHB CBCR 0x%08x\n", gdsc, mdp, ahb);
+	if (!(gdsc & (1u << 31)) || (mdp & (1u << 31)) || (ahb & (1u << 31))) {
+		IOLog("FAJITA DPU: display engine not powered/clocked by ABL; no kick\n");
+		return;
+	}
+	vm_offset_t m = ml_io_map(FAJITA_MDP_PA, FAJITA_MDP_SIZE);
+	if (m == 0) {
+		IOLog("FAJITA DPU: MDP map failed\n");
+		return;
+	}
+	bool autorefresh = false;
+	for (int n = 0; n < 4; n++) {
+		uint32_t te = *(volatile uint32_t *)(m + FAJITA_PP(n) + FAJITA_PP_TEAR_CHECK_EN);
+		uint32_t ar = *(volatile uint32_t *)(m + FAJITA_PP(n) + FAJITA_PP_AUTOREFRESH);
+		IOLog("FAJITA DPU: PP%d tear-check 0x%x autorefresh 0x%08x\n", n, te, ar);
+		if ((te & 1u) && (ar & (1u << 31))) {
+			autorefresh = true;
+		}
+	}
+	volatile uint32_t *ctl = NULL;
+	for (int n = 0; n < 5; n++) {
+		uint32_t top = *(volatile uint32_t *)(m + FAJITA_CTL(n) + FAJITA_CTL_TOP);
+		IOLog("FAJITA DPU: CTL%d top 0x%08x\n", n, top);
+		/* bit 17: command mode; [7:4]: interface (non-zero = in use) */
+		if (ctl == NULL && (top & (1u << 17)) && ((top >> 4) & 0xf)) {
+			ctl = (volatile uint32_t *)(m + FAJITA_CTL(n));
+		}
+	}
+	if (ctl == NULL) {
+		IOLog("FAJITA DPU: no command-mode CTL found (video mode?); no kick\n");
+		return;
+	}
+	if (autorefresh && mode != 2) {
+		IOLog("FAJITA DPU: hardware autorefresh is on (shim); no kick needed\n");
+		return;
+	}
+	fDpuCtl = ctl;
+	IOLog("FAJITA DPU: kicking CTL_START every vsync tick (%s)\n",
+	    mode == 2 ? "fajita_dpu=2" : "autorefresh off");
+}
+
+/* One frame transfer to the panel RAM, unless the previous one still runs. */
+void
+AppleCLCD::dpuKick(void)
+{
+	volatile uint32_t *ctl = fDpuCtl;
+	if (ctl == NULL) {
+		return;
+	}
+	if (ctl[FAJITA_CTL_START / 4] & 1u) {
+		fDpuBusy++;
+		return;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");      /* pixels before the kick */
+	ctl[FAJITA_CTL_START / 4] = 1;
+	if ((++fDpuKicks % 3600) == 0) {
+		IOLog("FAJITA DPU: %llu kicks, %llu skipped busy\n", fDpuKicks, fDpuBusy);
+	}
+}
