 #define SWEET_FB_LOGICAL_W              1125
 #define SWEET_FB_LOGICAL_H              2436
 #define SWEET_FB_FORMAT_BGRA            0x42475241
 
+/*
+ * fajita (OnePlus 6T): the s6e3fc2x01 panel is a MIPI DSI *command-mode*
+ * panel. Unlike sweet's video-mode panel, the display engine (SDM845 DPU
+ * 4.0) only sends a frame to the panel's own RAM when it is triggered, so
+ * pixels written into ABL's splash buffer are not shown by themselves.
+ * The boot shim (shim/fajita_disp.c) turns on the ping-pong block's
+ * hardware autorefresh, which re-sends the buffer on every tear-effect
+ * pulse. If that did not stick, this driver kicks CTL_START once per vsync
+ * tick instead. Boot-arg fajita_dpu: 0 = never touch the DPU, 1 = auto
+ * (default: kick only if autorefresh is off), 2 = always kick.
+ * Register offsets: Linux drivers/gpu/drm/msm/disp/dpu1 (dpu_4_0_sdm845.h,
+ * dpu_hw_ctl.c, dpu_hw_pingpong.c); MDP block at 0xae01000.
+ */
+#define FAJITA_DISPCC_PA                0x0af00000
+#define FAJITA_DISPCC_MDSS_GDSCR        0x3000          /* bit 31 PWR_ON */
+#define FAJITA_DISPCC_MDP_CBCR          0x200c          /* bit 31 CLK_OFF */
+#define FAJITA_DISPCC_AHB_CBCR          0x4004
+#define FAJITA_MDP_PA                   0x0ae01000
+#define FAJITA_MDP_SIZE                 0x8f000
+#define FAJITA_CTL(n)                   (0x1000 + 0x200 * (n))
+#define FAJITA_CTL_TOP                  0x14
+#define FAJITA_CTL_START                0x1c
+#define FAJITA_PP(n)                    (0x70000 + 0x800 * (n))
+#define FAJITA_PP_TEAR_CHECK_EN         0x00
+#define FAJITA_PP_AUTOREFRESH           0x30            /* bit 31 enable, [15:0] frames */
