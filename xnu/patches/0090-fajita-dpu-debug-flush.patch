-		/* fajita_dpu=2: manual kicks only, so switch autorefresh off first. */
+		/* fajita_dpu=2/3: manual kicks only, so switch autorefresh off first. */
 		*(volatile uint32_t *)(m + FAJITA_PP(arPP) + FAJITA_PP_AUTOREFRESH) = 0;
