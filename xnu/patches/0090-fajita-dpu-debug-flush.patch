@@ -107,10 +110,23 @@ enum {
 #define FAJITA_MDP_SIZE                 0x8f000
 #define FAJITA_CTL(n)                   (0x1000 + 0x200 * (n))
 #define FAJITA_CTL_TOP                  0x14
+#define FAJITA_CTL_FLUSH                0x18
 #define FAJITA_CTL_START                0x1c
 #define FAJITA_PP(n)                    (0x70000 + 0x800 * (n))
 #define FAJITA_PP_TEAR_CHECK_EN         0x00
 #define FAJITA_PP_AUTOREFRESH           0x30            /* bit 31 enable, [15:0] frames */
+#define FAJITA_PP_SYNC_CONFIG_VSYNC     0x04
+#define FAJITA_PP_SYNC_CONFIG_HEIGHT    0x08
+#define FAJITA_PP_LINE_COUNT            0x2c
+#define FAJITA_LM(n)                    (0x44000 + 0x1000 * (n))
+#define FAJITA_LM_OUT_SIZE              0x04
+/* source pipes VIG0-3, DMA0-3 (dpu_4_0_sdm845.h) and their CTL_FLUSH bits */
+static const uint32_t fajita_sspp[8] = {0x4000, 0x6000, 0x8000, 0xa000,
+	                                0x24000, 0x26000, 0x28000, 0x2a000};
+static const uint8_t fajita_sspp_flush[8] = {0, 1, 2, 18, 11, 12, 24, 25};
+/* CTL_LAYER(LM_n) offsets and LM_n flush bits */
+static const uint8_t fajita_layer_off[6] = {0x00, 0x04, 0x08, 0x0c, 0x10, 0x24};
+static const uint8_t fajita_lm_flush[6] = {6, 7, 8, 9, 10, 20};
 
 class IOMobileFramebuffer : public IOService {
 	OSDeclareDefaultStructors(IOMobileFramebuffer);
@@ -148,9 +164,12 @@ public:
 	uint32_t      fFadeStep;      /* fade-out steps done while off */
