+
+/* fajita_dpu=3: the display pipe as ABL left it and as our kicks see it. */
+void
+AppleCLCD::dpuDump(void)
+{
+	uintptr_t m = fDpuMdp;
+	if (m == 0) {
+		return;
+	}
+#define R(off) (*(volatile uint32_t *)(m + (off)))
+	for (int n = 0; n < 5; n++) {
+		uintptr_t c = FAJITA_CTL(n);
+		IOLog("FAJITA DPU: CTL%d top %08x flush %08x start %08x layer %08x %08x %08x %08x %08x %08x\n",
+		    n, R(c + FAJITA_CTL_TOP), R(c + FAJITA_CTL_FLUSH), R(c + FAJITA_CTL_START),
+		    R(c + 0x00), R(c + 0x04), R(c + 0x08), R(c + 0x0c), R(c + 0x10), R(c + 0x24));
+	}
+	for (int n = 0; n < 8; n++) {
+		uintptr_t p = fajita_sspp[n];
+		if (R(p + 0x14) == 0) {
+			continue;
+		}
+		/* SRC_SIZE, SRC_XY, OUT_SIZE, OUT_XY, SRC0_ADDR, YSTRIDE0, FORMAT, UNPACK, OP_MODE */
+		IOLog("FAJITA DPU: SSPP%d size %08x xy %08x out %08x oxy %08x addr %08x ystride %08x fmt %08x unpack %08x op %08x\n",
+		    n, R(p + 0x00), R(p + 0x08), R(p + 0x0c), R(p + 0x10), R(p + 0x14),
+		    R(p + 0x24), R(p + 0x30), R(p + 0x34), R(p + 0x38));
+	}
+	for (int n = 0; n < 4; n++) {
+		uintptr_t p = FAJITA_PP(n);
+		IOLog("FAJITA DPU: PP%d te %08x vsync %08x height %08x line %08x autorefresh %08x\n",
+		    n, R(p + FAJITA_PP_TEAR_CHECK_EN), R(p + FAJITA_PP_SYNC_CONFIG_VSYNC),
+		    R(p + FAJITA_PP_SYNC_CONFIG_HEIGHT), R(p + FAJITA_PP_LINE_COUNT),
+		    R(p + FAJITA_PP_AUTOREFRESH));
+	}
+	IOLog("FAJITA DPU: LM out %08x %08x; kicks %llu busy %llu\n",
+	    R(FAJITA_LM(0) + FAJITA_LM_OUT_SIZE), R(FAJITA_LM(1) + FAJITA_LM_OUT_SIZE),
+	    fDpuKicks, fDpuBusy);
+#undef R
 }
 
 /* One frame transfer to the panel RAM, unless the previous one still runs. */
@@ -323,10 +403,18 @@ AppleCLCD::dpuKick(void)
 		return;
 	}
 	__asm__ volatile ("dsb sy" ::: "memory");      /* pixels before the kick */
+	if (fDpuFlush != 0) {
+		/* fajita_dpu=3: latch the pipe configuration, then start (dpu_hw_ctl.c order) */
+		ctl[FAJITA_CTL_FLUSH / 4] = fDpuFlush;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
 	ctl[FAJITA_CTL_START / 4] = 1;
 	if ((++fDpuKicks % 3600) == 0) {
 		IOLog("FAJITA DPU: %llu kicks, %llu skipped busy\n", fDpuKicks, fDpuBusy);
 	}
+	if (fDpuMdp != 0 && (fDpuKicks % 1800) == 0) {
+		dpuDump();
+	}
 }
 
