 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 int sweet_rpmh_vreg_enable(const char *res, unsigned mv);
+int sweet_rpmh_cmd_db_aux(const char *res, uint8_t *buf, uint32_t max, uint32_t *len);
 
 /*
  * fajita (SDM845): apps_rsc drv-2 at 0x179e0000, qcom,tcs-offset 0xd00,
@@ -378,4 +379,63 @@ out:
 	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
 	return error;
 }
+/*
+ * Read-only cmd-db query for the Adreno GMU (bsd/dev/sweet_gpu_a6xx.c): the
+ * aux data of one resource of any slave (ARC "gfx.lvl" / "mx.lvl" / "cx.lvl"
+ * hold the u16 RPMh levels of each corner), as mainline cmd_db_read_aux_data.
+ * Sends nothing to the RSC.
+ */
+int
+sweet_rpmh_cmd_db_aux(const char *res, uint8_t *buf, uint32_t max, uint32_t *len)
+{
+	if (!res || !buf || !len) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = rh_map();
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; !error && i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = rh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + rh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + rh_db16(h + 4);
+		unsigned count = rh_db16(h + 6);
+		if ((entries & 3u) || !rh_range(entries, count * RH_DB_ENTRY) || !rh_range(aux, 0)) {
+			error = EINVAL;
+			break;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (rh_read(rh_db, e) != key[0] || rh_read(rh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t off = aux + rh_db16(e + 22), n = rh_db16(e + 20);
+			if (!rh_range(off, n) || n > max) {
+				error = EINVAL;
+				break;
+			}
+			for (uint32_t k = 0; k < n; ++k) {
+				uint32_t w = rh_read(rh_db, (off + k) & ~3u);
+				buf[k] = (uint8_t)(w >> (8u * ((off + k) & 3u)));
+			}
+			*len = n;
+			++matches;
+		}
+	}
+	if (!error && matches != 1) {
+		error = ENODEV;
+	}
+	printf("SWEET RPMH: cmd-db aux %s: %u bytes, errno %d\n", res, error ? 0 : *len, error);
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
